<div class="bento-gallery">
  <!-- Inside components/bento-grid.webc loop -->
  <a
    webc:for="item of $data.collections.sortedBento"
    :href="item.url"
    :class="'bento-card' + (item.data.bentoSize ? ' size-' + item.data.bentoSize : '')"
  >
    <!-- Image pane is completely separate from the text box -->
    <div class="bento-media">
      <img
        :src="item.data.bentoImg"
        :alt="item.data.bentoAlt || ''"
        loading="lazy"
        sizes="(min-width: 65rem) 400px, (min-width: 45rem) 50vw, 95vw"
      />
    </div>

    <!-- Content area has its own clean, high-contrast background surface -->
    <div class="bento-content">
      <h3 @text="item.data.title"></h3>
      <p webc:if="item.data.bentoDesc" webc:text="item.data.bentoDesc"></p>
    </div>
  </a>
</div>

<!-- Inside components/bento-grid.webc -->
<style webc:scoped>
  /* ==========================================================================
     1. THE MASTER BENTO TRACK ENGINE
     ========================================================================== */
  .bento-gallery {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--size-4);
    grid-auto-flow: row dense; /* Auto-packs small cards into empty gaps */
  }

  /* --- Tablet View (2 Columns) --- */
  @media (min-width: 45rem) {
    .bento-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* RESTORED: Let wide and big cards expand comfortably on tablets */
    .bento-card.size-feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bento-card.size-medium {
      grid-column: span 2;
    }
  }

  /* --- Large Desktop View (4 Columns) --- */
  @media (min-width: 65rem) {
    .bento-gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--size-5);
    }

    /*
      RESTORED: Explicitly locks your spanning ratios on large viewports
      so your featured wildlife profiles genuinely stand out!
    */
    .bento-card.size-feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bento-card.size-medium {
      grid-column: span 2;
    }
  }

  /* ==========================================================================
     2. CARD BASE & INTERNAL STYLING
     ========================================================================== */
  .bento-card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    background-color: var(--surface-default);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-1);
    transition:
      box-shadow 0.2s var(--ease-3),
      background-color 0.2s var(--ease-2);
  }

  .bento-card:is(:hover, :focus-visible) {
    box-shadow: var(--shadow-3);
    background-color: var(--surface-2);
  }

  .bento-media {
    width: 100%;
    overflow: hidden;
    background-color: var(--surface-3);
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      aspect-ratio: var(--ratio-landscape);
    }
  }

  .bento-content {
    padding: var(--size-4);
    display: flex;
    flex-direction: column;
    gap: var(--size-1);
    h3 {
      font-size: var(--font-size-2);
      font-weight: var(--font-weight-7);
      color: var(--text-primary);
      margin: 0;
      text-wrap: balance;
    }
    p {
      font-size: var(--font-size-1);
      color: var(--text-secondary);
      line-height: var(--font-lineheight-2);
      margin: 0;
      text-wrap: pretty;
    }
  }

  /* ==========================================================================
     3. INTERNAL COMPONENT CONTAINER QUERY (Side-by-Side Split)
     ========================================================================== */
  @container (min-width: 28rem) {
    .bento-card {
      flex-direction: row;
      align-items: stretch;
    }
    .bento-media {
      width: 40%;
      flex-grow: 0;
      img {
        aspect-ratio: auto;
      } /* Automatically match expanded text height */
    }
    .bento-content {
      width: 60%;
      padding: var(--size-5);
      justify-content: center;
    }
  }
</style>
