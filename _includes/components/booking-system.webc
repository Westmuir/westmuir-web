<!-- src/_components/booking-system.webc -->
<div class="booking-container">
  <h2>Village Hall Bookings</h2>

  <!-- 1. The Real-Time Calendar/List View (Stays Visible as the primary focus) -->
  <section class="booking-status">
    <h3>Current Bookings</h3>
    <div hx-get="/api/bookings" hx-trigger="load" hx-swap="innerHTML">
      <p class="loading-text">Checking available dates...</p>
    </div>
  </section>

  <!-- 2. The Collapsible Request Form Section -->
  <section class="booking-form-box">
    <!-- Native Accordion Element -->
    <details class="booking-accordion">
      <!-- The <summary> tag acts as the click target button to toggle visibility -->
      <summary class="btn-toggle-form">Make a New Booking Request</summary>

      <div id="form-result" class="accordion-content">
        <form hx-post="/api/book" hx-target="#form-result" hx-swap="innerHTML">
          <div class="form-group">
            <label for="booking-date">Select Date</label>
            <input type="date" id="booking-date" name="date" required />
          </div>

          <div class="form-group">
            <label for="booking-name">Your Name / Organisation</label>
            <input type="text" id="booking-name" name="name" placeholder="e.g., W.I. Meeting" required />
          </div>

          <div class="form-group">
            <label for="booking-email">Contact Email</label>
            <input type="email" id="booking-email" name="email" required />
          </div>

          <button type="submit" class="btn-submit">Submit Tentative Booking</button>
        </form>
      </div>
    </details>
  </section>
</div>

<!-- Component-Specific Styling inside booking-system.webc -->
<style webc:type="scss">
  .booking-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--size-6);
    margin: var(--size-6) 0;
    font-family: 'Merriweather Sans', sans-serif;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .booking-status,
  .booking-form-box {
    /* ADAPTIVE: Swaps to a dark container in dark mode, light container in light mode */
    background: var(--surface-2);
    padding: var(--size-5);
    border: var(--border-size-1) solid var(--surface-3);
    border-radius: var(--radius-3);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  }

  h3 {
    margin-top: 0;
    /* ADAPTIVE: Changes color automatically based on global theme text selection */
    color: var(--text-1);
    border-bottom: var(--border-size-2) solid var(--surface-4);
    padding-bottom: var(--size-2);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--size-2);
    margin-bottom: var(--size-4);

    label {
      font-weight: var(--font-weight-6);
      font-size: var(--font-size-0);
      color: var(--text-2); /* Slightly muted text for labels */
    }

    input {
      padding: var(--size-2);
      border: var(--border-size-1) solid var(--surface-4);
      border-radius: var(--radius-1);
      font-size: var(--font-size-1);

      /* ADAPTIVE: Form fields will have dark inputs in dark mode */
      background: var(--surface-1);
      color: var(--text-1);

      &:focus {
        outline: none;
        border-color: var(--blue-6);
        box-shadow: 0 0 0 var(--border-size-3) var(--blue-2);
      }
    }
  }

  .btn-submit {
    width: 100%;
    padding: var(--size-3);
    background-color: var(--blue-6);
    color: white; /* Keeping this bright white so it stands out against the blue button background */
    border: none;
    border-radius: var(--radius-2);
    font-size: var(--font-size-1);
    cursor: pointer;
    font-weight: var(--font-weight-7);
    transition: background 0.2s;

    &:hover {
      background-color: var(--blue-7);
    }
  }

  .loading-text {
    color: var(--text-3);
    font-style: italic;
  }

  /* Styling for the list items that are fed in dynamically from your API */
  .bookings-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .booking-item {
    color: var(--text-1);
    background: var(--surface-3);
    padding: var(--size-2) var(--size-3);
    margin-bottom: var(--size-2);
    border-radius: var(--radius-1);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>
