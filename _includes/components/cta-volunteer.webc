<section class="cta">
  <a :href="buttonurl">
    <h2 @text="heading ?? 'Join the Westmuir Community'"></h2>
    <p
      @text="description ?? 'Get involved with events, news, and village life.'"
    ></p>
    <button class="btn" @text="buttonlabel"></button>
  </a>
</section>

<style>
  :where(.cta) {
    --cta-background-color: light-dark(var(--camo-9), var(--camo-11));
    --header-background-color: light-dark(var(--camo-8), var(--camo-9));
    --header-text-color: light-dark(var(--camo-1), var(--camo-1));

    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 2rem auto;
    text-align: center;
    background-color: var(--header-background-color);
    color: var(--header-text-color);
    border-radius: 0.5rem;
    max-width: 800px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;

    a {
      padding: 2rem;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    .cta-l {
      margin-left: inherit;
    }

    .cta-sm {
      padding: 1rem;
      margin: 1rem;
      max-width: 500px;
    }
    .cta-post {
      background-color: var(--cta-background-color, #222);
    }

    h2 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      font-size: 1.2rem;
      background-color: var(--cyan-10);
      color: var(--header-text-color);
      border-radius: 10px;
      margin-bottom: 1rem;
    }
  }
</style>
