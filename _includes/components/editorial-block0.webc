<div class="editorial-wrapper">
  <div class="editorial-mesh" :data-align="align || 'right'">
    <div class="prose-pane">
      <slot></slot>
    </div>

    <figure class="image-pane">
      <!-- Accessible button wrapper to launch the lightbox -->
      <button
        type="button"
        class="lightbox-trigger"
        aria-haspopup="dialog"
        :aria-label="'Enlarge ' + alt"
      >
        <img
          :src="src"
          :alt="alt"
          :width="width"
          height="auto"
          sizes="(min-width: 50rem) 35ch, 90vw"
        />
      </button>
      <figcaption webc:if="caption" webc:text="caption"></figcaption>
    </figure>
  </div>

  <!-- Open Props UI Dialog Modal -->
  <dialog class="ui-dialog lightbox-modal">
    <form method="dialog">
      <!-- Click overlay or button to close -->
      <button class="close-btn" aria-label="Close lightbox">✕</button>
    </form>
    <div class="modal-body">
      <!-- This empty image tag will dynamically pull the original crisp 2400px source on click -->
      <img src="" :alt="alt" class="lightbox-target" />
      <p webc:if="caption" class="lightbox-caption" webc:text="caption"></p>
    </div>
  </dialog>
</div>
