<!--- components/generator-log-viewer.webc --->
<div class="log-viewer">
  <div class="toolbar">
    <div class="search-wrapper">
      <input
        type="text"
        class="search-box"
        placeholder="🔍 Search records (e.g., initials, notes)..."
      />
    </div>
    <div class="select-wrapper">
      <select class="year-select">
        <option value="2026" selected>2026</option>
        <option value="2025">2025</option>
        <option value="2024">2024</option>
      </select>
    </div>
  </div>

  <!-- The Unified Grid Spreadsheet Layout Canvas -->
  <div class="grid-spreadsheet">
    <!-- Table Headers (Hidden on Mobile via CSS) -->
    <div class="grid-header-row">
      <div>Reason</div>
      <div>Date</div>
      <div>Run Window</div>
      <div>Battery Status</div>
      <div>Fuel Loss</div>
      <div>Op</div>
      <div class="actions-column">Actions</div>
    </div>

    <!-- Target injection wrapper for rows -->
    <div class="logs-table-body">
      <div class="loading-state">Loading generator log history...</div>
    </div>
  </div>
</div>
<script src="/js/generator-log-viewer.js" type="module" webc:keep></script>

<style>
  :where(.log-viewer) {
    --_base-tracks: 0.8fr 1fr 1.5fr 1.3fr 1.2fr 0.8fr;

    --field-border-color: var(--text-primary);

    /* --- TOOLBAR CONTROLS --- */
    .toolbar {
      display: flex;
      gap: var(--size-3);
      margin-bottom: var(--size-4);
    }
    .search-wrapper {
      flex: 1;
    }
    .search-box,
    .year-select {
      padding: var(--size-2);
      font-size: var(--font-size-1);
      border: var(--border-width) solid var(--field-border-color);
      border-radius: var(--field-border-radius);
      background: var(--surface-default);
      color: var(--text-primary);
      width: 100%;
    }
    /* --- MOBILE FIRST LAYOUT: Stacked Cards --- */
    .grid-header-row {
      display: none; /* Hide wide headers on phone screen limits */
    }

    .log-row {
      background: var(--surface-default);
      display: flex;
      flex-direction: column;
      border: var(--border-width) solid var(--field-border-color);
      border-radius: var(--field-border-radius);
      padding: var(--size-3);
      margin-bottom: var(--size-3);
      gap: var(--size-2);
      box-shadow: var(--shadow-1);
    }

    .log-cell {
      display: flex;
      font-size: var(--font-size-1);
      line-height: var(--font-lineheight-2);
      color: var(--text-primary);
    }

    /* Explicit Mobile Row Label Prefixes */
    .cell-label {
      font-weight: var(--font-weight-7);
      color: var(--text-primary);
      width: 90px;
      flex-shrink: 0;
    }

    .actions-column,
    .actions-cell {
      display: none;
    }
    /* --- TABLET & DESKTOP LAYOUT UPGRADE --- */
    @media (min-width: 768px) {
      .cell-label {
        display: none; /* Strip out inline mobile helper text labels */
      }

      .grid-spreadsheet {
        border: var(--border-width) solid var(--field-border-color);
        border-radius: var(--field-border-radius);
        background: var(--surface-elevated);
        overflow: hidden;
        box-shadow: var(--shadow-2);
      }

      /* 1. Single Central Source of Truth for standard columns */
      .grid-header-row,
      .log-row {
        display: grid;
        align-items: center;
        border-bottom: var(--border-width) solid var(--field-border-color);
        grid-template-columns: var(--_base-tracks);
        padding: 0; /* Clear mobile card paddings */
        margin-bottom: 0;
        border-radius: 0;
        box-shadow: none;
      }

      .log-row:last-child {
        border-bottom: none;
      }

      .grid-header-row {
        border-bottom: 2px solid #cbd5e1;
        background: var(--surface-elevated);
        font-weight: var(--font-weight-7);
        color: var(--text-primary);
        border-bottom: calc(var(--border-width) * 2) solid
          var(--field-border-color);

        padding: var(--size-2);
        justify-items: center;
      }

      .log-cell {
        border: none;
        padding: var(--size-2) var(--size-3);
      }
    }

    /* --- UTILITIES & SYSTEM BADGES --- */
    .loading-state,
    .empty-state,
    .error-state {
      font-style: italic;
      padding: var(--size-5);
      text-align: center;
      color: var(--text-primary);
      font-style: italic;
    }

    .status-badge {
      display: inline-block;
      padding: var(--size-1) var(--size-2);
      border-radius: var(--radius-1);
      font-size: var(--font-size-0);
      font-weight: bold;
      text-transform: uppercase;
      text-align: center;
      min-inline-size: 60px;
    }

    .state-m {
      background: light-dark(var(--orange-2), var(--orange-9));
      color: light-dark(var(--orange-9), var(--orange-1));
    }
    .state-a {
      background: light-dark(var(--green-2), var(--green-9));
      color: light-dark(var(--green-9), var(--green-1));
    }
    .state-r {
      background: light-dark(var(--blue-2), var(--blue-9));
      color: light-dark(var(--blue-9), var(--blue-1));
    }
    .state-s {
      background: light-dark(var(--red-2), var(--red-9));
      color: light-dark(var(--red-9), var(--red-1));
    }
  }

  /* 3. Conditional Admin Context Overrides (Un-nested) */
  @container style(--is-admin-panel: 1) {
    @media (min-width: 768px) {
      [data-user-role="admin"] :where(.log-viewer) {
        .grid-header-row,
        .log-row {
          grid-template-columns: var(--_base-tracks) 1.2fr;
        }
      }
    }

    [data-user-role="admin"] :where(.log-viewer) {
      .actions-column {
        display: block;
      }

      .actions-cell {
        display: flex;
        gap: var(--size-2);
      }

      /* Small touch padding fix for action buttons inside mobile stacked card view */
      @media (max-width: 767px) {
        .actions-cell {
          border-top: var(--border-width) solid var(--border-color);
          padding-top: var(--size-2);
          margin-top: var(--size-1);
        }
      }
    }
  }
</style>
