<!-- Pass layout="strip" or layout="grid" when using the component -->
<section class="breakout image-gallery-section flow">
  <div class="gallery-intro">
    <slot><h2>Gallery</h2></slot>
  </div>

  <!-- We pass the layout attribute down to control our CSS styling -->
  <image-lightbox-gallery
    :class="layout === 'strip' ? 'layout-strip' : 'layout-grid'"
  >
    <!-- The exact same DOM structure for images -->
    <div class="image-gallery-container">
      <figure
        webc:for="(item, index) of collection"
        :class="`gallery-item ${layout !== 'strip' ? (Number(index) % 5 === 0 ? 'item-wide' : (Number(index) % 3 === 0 ? 'item-tall' : '')) : ''}`"
      >
        <button
          type="button"
          class="gallery-trigger"
          :data-alt="item.alt"
          aria-label="View larger image"
        >
          <img :src="item.src" :alt="item.alt" loading="lazy" />
        </button>
        <figcaption @text="item.alt"></figcaption>
      </figure>
    </div>

    <!-- The exact same Lightbox Modal is preserved here -->
    <dialog class="lightbox-modal">
      <form method="dialog">
        <button class="close-btn" aria-label="Close modal">✕</button>
      </form>

      <div class="lightbox-content">
        <button
          type="button"
          class="nav-btn prev-btn"
          aria-label="Previous image"
        >
          ‹
        </button>

        <figure>
          <img class="lightbox-img" src="" alt="" />
          <figcaption class="lightbox-caption"></figcaption>
        </figure>

        <button type="button" class="nav-btn next-btn" aria-label="Next image">
          ›
        </button>
      </div>
    </dialog>
  </image-lightbox-gallery>
</section>

<!-- The Client-Side JavaScript remains 100% identical and unchanged -->
<script>
  class ImageLightboxGallery extends HTMLElement {
    connectedCallback() {
      // We update this target selector to use the generic container class
      this.grid = this.querySelector(".image-gallery-container");
      this.dialog = this.querySelector(".lightbox-modal");
      this.lightboxImg = this.querySelector(".lightbox-img");
      this.lightboxCaption = this.querySelector(".lightbox-caption");
      this.prevBtn = this.querySelector(".prev-btn");
      this.nextBtn = this.querySelector(".next-btn");

      this.items = [];
      this.currentIndex = 0;

      const triggers = this.grid.querySelectorAll(".gallery-trigger");
      triggers.forEach((btn, index) => {
        const liveImg = btn.querySelector("img");
        btn.setAttribute("data-index", index);

        this.items.push({
          src: liveImg.currentSrc || liveImg.src,
          alt: btn.getAttribute("data-alt"),
        });
      });

      this.grid.addEventListener("click", (e) => this.handleImageClick(e));
      this.prevBtn.addEventListener("click", () => this.navigate(-1));
      this.nextBtn.addEventListener("click", () => this.navigate(1));

      this.dialog.addEventListener("keydown", (e) => this.handleKeyDown(e));
      this.dialog.addEventListener("click", (e) => this.handleBackdropClick(e));
    }

    updateLightbox(index) {
      this.currentIndex = index;
      const item = this.items[this.currentIndex];
      this.lightboxImg.src = item.src;
      this.lightboxImg.alt = item.alt;
      this.lightboxCaption.textContent = item.alt;
    }

    navigate(direction) {
      let newIndex =
        (this.currentIndex + direction + this.items.length) % this.items.length;
      this.updateLightbox(newIndex);
    }

    handleImageClick(e) {
      const trigger = e.target.closest(".gallery-trigger");
      if (!trigger) return;

      const index = parseInt(trigger.getAttribute("data-index"), 10);
      this.updateLightbox(index);
      this.dialog.showModal();
    }

    handleKeyDown(e) {
      if (e.key === "ArrowLeft") this.navigate(-1);
      if (e.key === "ArrowRight") this.navigate(1);
    }

    handleBackdropClick(e) {
      if (e.target === this.dialog) this.dialog.close();
    }
  }

  if (
    "customElements" in window &&
    !customElements.get("image-lightbox-gallery")
  ) {
    customElements.define("image-lightbox-gallery", ImageLightboxGallery);
  }
</script>

<style>
  /* --- REUSABLE UTILITIES & LIGHTBOX VISUALS --- */
  .gallery-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 100%;
    display: block;
  }

  .lightbox-modal::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(2px);
  }

  .lightbox-modal {
    border: none;
    background: transparent;
    padding: 0;
    margin: 100px auto auto auto;
    max-width: 90vw;
    max-height: calc(100vh - 150px);
    color: white;
    overflow: visible;
  }

  .lightbox-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    position: relative;
  }

  .lightbox-content figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-content img {
    max-width: 75vw;
    max-height: calc(100vh - 220px);
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .lightbox-content figcaption {
    text-align: center;
    margin-top: 1rem;
    font-size: 1.1rem;
  }

  .close-btn,
  .nav-btn {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    font-size: 1.5rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s;
  }

  .close-btn:hover,
  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .close-btn {
    position: absolute;
    top: -3.5rem;
    right: 0;
    z-index: 10;
  }

  /* --- VARIANT 1: GRID MODE --- */
  .layout-grid .image-gallery-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  /* --- VARIANT 2: HORIZONTAL STRIP MODE --- */
  .layout-strip .image-gallery-container {
    display: flex;
    overflow-x: auto;
    gap: 0.5rem; /* Tighter gaps for a cleaner strip look */
    padding-bottom: 0.75rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .layout-strip .gallery-item {
    flex: 0 0 auto;

    /*
      FLUID WIDTH CALCULATION:
      - 100% / 5.5 means exactly 5 full images fit on screen,
        and the 6th is cut in half to visually hint that it's scrollable!
    */
    width: calc(100% / 5.5);

    scroll-snap-align: start;
  }

  /* Make sure it handles smaller mobile screens elegantly */
  @media (max-width: 768px) {
    .layout-strip .gallery-item {
      width: calc(100% / 3.5); /* Shows ~3.5 images on mobile */
    }
  }

  .layout-strip .gallery-item img {
    height: 110px; /* Shorter height to match the smaller width footprint */
    width: 100%;
    object-fit: cover;
    border-radius: 4px;
    transition: transform 0.2s ease;
  }

  .layout-strip .gallery-item img:hover {
    transform: scale(1.03); /* Subtle interactive hint */
  }

  /* Hide captions in the compact strip view to keep it minimal */
  .layout-strip figcaption {
    display: none;
  }
</style>
