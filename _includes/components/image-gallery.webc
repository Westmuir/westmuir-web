<!-- Pass layout="strip" or layout="grid" when using the component -->
<section class="breakout image-gallery-section flow">
  <div class="gallery-intro">
    <slot><h2>Gallery</h2></slot>
  </div>

  <image-lightbox-gallery
    :class="layout === 'strip' ? 'layout-strip' : 'layout-grid'"
  >
    <!-- Reusable flexible structural box -->
    <div class="image-gallery-container">
      <figure
        webc:for="(item, index) of collection"
        :class="`gallery-item ${layout !== 'strip' ? (Number(index) % 5 === 0 ? 'item-wide' : (Number(index) % 3 === 0 ? 'item-tall' : '')) : ''}`"
      >
        <button
          type="button"
          class="gallery-trigger"
          :data-alt="item.alt"
          aria-label="View larger image"
        >
          <img :src="item.src" :alt="item.alt" loading="lazy" />
        </button>
        <figcaption @text="item.alt"></figcaption>
      </figure>
    </div>

    <!-- REFACTOR: Replaced with clean Open Props UI class patterns -->
    <dialog class="ui-dialog lightbox-modal" closedby="any">
      <!-- OpUI Standard Header controls -->
      <div class="ui-header">
        <span class="lightbox-caption">Image View</span>
        <button
          class="ui-icon-button close-btn"
          title="Close"
          onclick="this.closest('dialog').close()"
        >
          <svg xmlns="http://w3.org" width="32" height="32" viewBox="0 0 32 32">
            <path
              fill="currentColor"
              d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
            />
          </svg>
        </button>
      </div>

      <!-- Main Layout Body Box -->
      <div class="ui-content lightbox-content">
        <button
          type="button"
          class="ui-icon-button nav-btn prev-btn"
          aria-label="Previous image"
        >
          ‹
        </button>
        <img class="lightbox-img" src="" alt="" />
        <button
          type="button"
          class="ui-icon-button nav-btn next-btn"
          aria-label="Next image"
        >
          ›
        </button>
      </div>
    </dialog>
  </image-lightbox-gallery>
</section>

<script>
  class ImageLightboxGallery extends HTMLElement {
    connectedCallback() {
      this.grid = this.querySelector(".image-gallery-container");
      this.dialog = this.querySelector(".lightbox-modal");
      this.lightboxImg = this.querySelector(".lightbox-img");
      this.lightboxCaption = this.querySelector(".lightbox-caption");
      this.prevBtn = this.querySelector(".prev-btn");
      this.nextBtn = this.querySelector(".next-btn");

      this.items = [];
      this.currentIndex = 0;

      // Extract details mapping securely
      const triggers = this.grid.querySelectorAll(".gallery-trigger");
      triggers.forEach((btn, index) => {
        const liveImg = btn.querySelector("img");
        btn.setAttribute("data-index", index);

        this.items.push({
          src: liveImg.currentSrc || liveImg.src,
          alt: btn.getAttribute("data-alt"),
        });
      });

      this.grid.addEventListener("click", (e) => this.handleImageClick(e));
      this.prevBtn.addEventListener("click", () => this.navigate(-1));
      this.nextBtn.addEventListener("click", () => this.navigate(1));
      this.dialog.addEventListener("keydown", (e) => this.handleKeyDown(e));
    }

    updateLightbox(index) {
      this.currentIndex = index;
      const item = this.items[this.currentIndex];
      this.lightboxImg.src = item.src;
      this.lightboxImg.alt = item.alt;
      this.lightboxCaption.textContent = item.alt || "Image View";
    }

    navigate(direction) {
      let newIndex =
        (this.currentIndex + direction + this.items.length) % this.items.length;
      this.updateLightbox(newIndex);
    }

    handleImageClick(e) {
      const trigger = e.target.closest(".gallery-trigger");
      if (!trigger) return;

      const index = parseInt(trigger.getAttribute("data-index"), 10);
      this.updateLightbox(index);
      this.dialog.showModal();
    }

    handleKeyDown(e) {
      if (e.key === "ArrowLeft") this.navigate(-1);
      if (e.key === "ArrowRight") this.navigate(1);
    }
  }

  if (
    "customElements" in window &&
    !customElements.get("image-lightbox-gallery")
  ) {
    customElements.define("image-lightbox-gallery", ImageLightboxGallery);
  }
</script>

<style>
  .image-gallery-section {
    margin-block: var(--size-9, 4rem);

    .gallery-intro {
      max-inline-size: var(--size-content-3, 70ch);
    }
  }
  /* --- OPEN PROPS TOKEN INTEGRATION --- */
  .gallery-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 100%;
    display: block;
    border-radius: var(--radius-2);
    overflow: hidden;
  }

  /* Refined Lightbox Container Modal */
  dialog.lightbox-modal {
    background-color: var(--surface-default);
    box-shadow: var(--shadow-5);
    border-radius: var(--radius-3);
    max-width: var(--size-md);
    width: 90vw;
    padding: 0;
    overflow: hidden;

    /* Elegant native Open Props transition profiles */
    transition: transform var(--transition-fade-duration) var(--ease-out);
  }

  .lightbox-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--size-4);
    padding: var(--size-4);
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-3);
  }

  /* Format explicit control icons */
  .nav-btn {
    font-size: var(--font-size-4);
    background-color: var(--surface-filled);
    color: var(--text-primary);
    flex-shrink: 0;
  }

  /* --- VARIANT 1: GRID MODE --- */
  .layout-grid .image-gallery-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--size-4);
  }

  /* --- VARIANT 2: OPEN PROPS SWIPING STRIP --- */
  .layout-strip .image-gallery-container {
    display: flex;
    overflow-x: auto;
    gap: var(--size-2);
    padding-bottom: var(--size-3);
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Keeps tracking clean and minimalist */
  }
  .layout-strip .image-gallery-container::-webkit-scrollbar {
    display: none;
  }

  .layout-strip .gallery-item {
    flex: 0 0 auto;
    width: calc(100% / 5.5);
    scroll-snap-align: start;
  }

  @media (max-width: 768px) {
    .layout-strip .gallery-item {
      width: calc(100% / 2.5); /* Optimized thumbnail balance on viewports */
    }
  }

  .layout-strip .gallery-item img {
    height: var(
      --size-11
    ); /* Switched hard values for responsive Open Props sizing */
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-2);
    transition: transform 0.2s var(--ease-out);
  }

  .layout-strip .gallery-item img:hover {
    transform: scale(var(--scale-1));
  }

  .layout-strip figcaption {
    display: none;
  }
</style>
