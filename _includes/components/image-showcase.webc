<section class="breakout image-gallery-section flow">
  <div class="gallery-intro">
    <slot><h2>Gallery</h2></slot>
  </div>

  <image-lightbox-gallery>
    <!-- Your clean webc:for loop structure -->
    <div class="image-gallery-grid">
      <figure
        webc:for="(item, index) of collection"
        :class="Number(index) % 5 === 0 ? 'item-wide' : (Number(index) % 3 === 0 ? 'item-tall' : '')"
        class="gallery-item"
      >
        <button
          type="button"
          class="gallery-trigger"
          :data-alt="item.alt"
          aria-label="View larger image"
        >
          <img :src="item.src" :alt="item.alt" loading="lazy" />
        </button>
        <figcaption @text="item.alt"></figcaption>
      </figure>
    </div>

    <!-- The Lightbox Modal Structure -->
    <dialog class="lightbox-modal">
      <form method="dialog">
        <button class="close-btn" aria-label="Close modal">✕</button>
      </form>

      <div class="lightbox-content">
        <button
          type="button"
          class="nav-btn prev-btn"
          aria-label="Previous image"
        >
          ‹
        </button>

        <figure>
          <img class="lightbox-img" src="" alt="" />
          <figcaption class="lightbox-caption"></figcaption>
        </figure>

        <button type="button" class="nav-btn next-btn" aria-label="Next image">
          ›
        </button>
      </div>
    </dialog>
  </image-lightbox-gallery>
</section>

<!-- Client-side script handling browser runtime -->
<script>
  class ImageLightboxGallery extends HTMLElement {
    connectedCallback() {
      this.grid = this.querySelector(".image-gallery-grid");
      this.dialog = this.querySelector(".lightbox-modal");
      this.lightboxImg = this.querySelector(".lightbox-img");
      this.lightboxCaption = this.querySelector(".lightbox-caption");
      this.prevBtn = this.querySelector(".prev-btn");
      this.nextBtn = this.querySelector(".next-btn");

      this.items = [];
      this.currentIndex = 0;

      // Let JavaScript index the items safely based on their actual DOM loop order
      const triggers = this.grid.querySelectorAll(".gallery-trigger");
      triggers.forEach((btn, index) => {
        const liveImg = btn.querySelector("img");

        // Explicitly set the DOM attribute to guarantee it is there for the click event
        btn.setAttribute("data-index", index);

        this.items.push({
          src: liveImg.currentSrc || liveImg.src,
          alt: btn.getAttribute("data-alt"),
        });
      });

      this.grid.addEventListener("click", (e) => this.handleImageClick(e));
      this.prevBtn.addEventListener("click", () => this.navigate(-1));
      this.nextBtn.addEventListener("click", () => this.navigate(1));

      this.dialog.addEventListener("keydown", (e) => this.handleKeyDown(e));
      this.dialog.addEventListener("click", (e) => this.handleBackdropClick(e));
    }

    updateLightbox(index) {
      this.currentIndex = index;
      const item = this.items[this.currentIndex];
      this.lightboxImg.src = item.src;
      this.lightboxImg.alt = item.alt;
      this.lightboxCaption.textContent = item.alt;
    }

    navigate(direction) {
      let newIndex =
        (this.currentIndex + direction + this.items.length) % this.items.length;
      this.updateLightbox(newIndex);
    }

    handleImageClick(e) {
      const trigger = e.target.closest(".gallery-trigger");
      if (!trigger) return;

      const index = parseInt(trigger.getAttribute("data-index"), 10);
      this.updateLightbox(index);
      this.dialog.showModal();
    }

    handleKeyDown(e) {
      if (e.key === "ArrowLeft") this.navigate(-1);
      if (e.key === "ArrowRight") this.navigate(1);
    }

    handleBackdropClick(e) {
      if (e.target === this.dialog) this.dialog.close();
    }
  }

  if (
    "customElements" in window &&
    !customElements.get("image-lightbox-gallery")
  ) {
    customElements.define("image-lightbox-gallery", ImageLightboxGallery);
  }
</script>

<style>
  .gallery-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 100%;
    display: block;
  }

  /* Lightbox Backdrop Styling */
  .lightbox-modal::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(2px);
  }

  /*
    MODAL POSITION FIX:
    Browsers use default absolute centring for <dialog>.
    We override margins to force horizontal centering and set an explicit top offset.
  */
  .lightbox-modal {
    border: none;
    background: transparent;
    padding: 0;

    /* Center horizontally, offset 100px from top viewport boundary */
    margin: 100px auto auto auto;

    max-width: 90vw;
    max-height: calc(
      100vh - 150px
    ); /* Keeps image contained above viewport fold */
    color: white;
    overflow: visible;
  }

  .lightbox-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    position: relative;
  }

  /* Keep the primary rendering bounds snappy and contained */
  .lightbox-content figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-content img {
    max-width: 75vw;
    max-height: calc(
      100vh - 220px
    ); /* Scales cleanly across small/large screen heights */
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .lightbox-content figcaption {
    text-align: center;
    margin-top: 1rem;
    font-size: 1.1rem;
  }

  /* Buttons Styling */
  .close-btn,
  .nav-btn {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    font-size: 1.5rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s;
  }

  .close-btn:hover,
  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* Position close button beautifully right above the wrapper frame */
  .close-btn {
    position: absolute;
    top: -3.5rem;
    right: 0;
    z-index: 10;
  }
</style>
