<div class="nav-wrapper">
  <ul class="section-cards">
    <li
      class="section-card na sc-bg"
      webc:for="item of cards"
      :style="`background-color: ${item.bg || 'inherit'}`"
    >
      <a :href="item.url">
        <div class="section-cards-title">
          <img
            webc:if="item.image"
            src="{{ item.image }}"
            alt="{{ item.label }} image"
            class="card-image"
          />
          <div
            webc:elseif="item.icon"
            class="material-symbols-outlined"
            @raw="item.icon"
          ></div>
          <h3 @text="item.label"></h3>
        </div>
        <p @text="item.description"></p>
      </a>
    </li>
  </ul>
</div>

<style>
  :where(.section-cards) {
    --margin-color-hall: light-dark(#d073d4, #864a89);
    --margin-color-na: light-dark(#3f4f8080, #3f4f8080);
    .hall,
    .postlist .hall {
      border-bottom: 10px solid var(--margin-color-hall, #803f6380);
    }

    .na {
      border-bottom: 10px solid var(--margin-color-na, #3f4f8080);
    }
  }
  .sc-bg {
    background-color: red;
  }
  ul.section-cardsX {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space, 1rem);
    justify-content: flex-start;

    list-style-type: none;
    margin-block: var(--size-1);
    padding: 0;

    .section-cards-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;

      > div {
        font-size: var(--font-size-6);
        margin-bottom: var(--size-2);
      }
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    li {
      display: inline-block;
      margin: 0 0 0.5rem 0;
      padding: 0.5rem;
      border-top: 1px solid var(--border-color, #ddd);
      border-left: 1px solid var(--border-color, #ddd);
      border-right: 1px solid var(--border-color, #ddd);
      border-radius: 0.5rem;
      box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.1);
    }
  }

  .section-card {
    width: 18ch;
    overflow: hidden;
    background-color: var(--surface-default, #fff);

    &:hover {
      transform: translateY(-2px);
