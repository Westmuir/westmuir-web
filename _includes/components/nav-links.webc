<div id="nav-links-box" class="nav-links">
  <!--- Loop over the global navigation JSON array --->
  <a
    webc:for="item of $data.navigation"
    :href="item.url"
    :class="item.exact && $data.page.url === item.url ? 'active' :
      item.includes && $data.page.url.includes(item.url) ? 'active' :
      !item.exact && !item.includes && $data.page.url === item.url ? 'active' : '' "
    @text="item.label"
  ></a>
</div>
