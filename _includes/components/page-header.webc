<!-- _components/page-header.webc -->
<figure class="page-header" :position="pos" webc:root="override">
  <!-- The background image (whether 11ty leaves it naked or wraps it) -->
  <picture webc:if="image">
    <img
      :src="image"
      :alt="alt || 'Section header graphic'"
      width="1980"
      sizes="100vw"
    />
  </picture>

  <!-- The text overlay content block -->
  <div class="page-header-info">
    <div class="content">
      <h1 @text="title"></h1>
      <p webc:if="description" @text="description"></p>
    </div>
  </div>
</figure>

<style>
  .page-header {
    /* 1. THE PILE: Define a single grid area where everything stacks */
    display: grid;
    grid-template-areas: "pile";
    align-items: center;

    height: clamp(8rem, 15vw, 12rem);
    background-color: var(--primary);
    background-image: var(--themed-gradient-30);
    overflow: hidden; /* Keeps the clip-path / images clean at the edges */

    /* 2. Assign ALL children layers to the exact same pile area */
    > picture,
    > img,
    .page-header-info {
      grid-area: pile;
    }

    /* 3. Style the background graphic layer */
    img {
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: cover;
      filter: brightness(0.75);
      object-position: bottom; /* Default fallback */
    }

    /* Position attributes target the image directly and cleanly */
    &[position="top"] img {
      object-position: top;
    }
    &[position="center"] img {
      object-position: center;
    }
    &[position="bottom"] img {
      object-position: bottom;
    }

    /* 4. Style the text information layer */
    .page-header-info {
      display: flex;
      padding-inline-start: var(--size-7);
      max-inline-size: var(--size-content-3, 75ch);
      justify-self: start;

      .content {
        flex: 1;
        display: flex;
        max-width: 560px;
        flex-direction: column;
        justify-content: center;
        gap: var(--size-2, 8px);
        background: var(--color-8);
        clip-path: polygon(100% 0, 100% 31%, 92% 100%, 0 100%, 0 0);
        padding: var(--size-3) var(--size-5) var(--size-3) var(--size-4);
        width: 95%;

        > h1 {
          font-family: "Merriweather Sans", sans-serif;
          font-size: clamp(
            1.5rem,
            3.5vw,
            2.25rem
          ); /* Tweak sizes slightly for fluid header */

          line-height: var(--font-lineheight-1, 1.1);
          font-weight: 800;
          letter-spacing: -0.03em;
          color: var(--gray-2);
          text-shadow: 0 var(--size-1) var(--size-2)
            color-mix(in oklch, var(--color-1) 35%, transparent);
        }

        > p {
          font-size: clamp(0.95rem, 1.8vw, 1.1rem);
          max-inline-size: 100%;
          color: var(--gray-2);
          font-weight: 500;
          padding-inline-end: var(--size-6, 2rem);
        }
      }
    }
  }
</style>
