<!-- _components/page-header.webc -->
<figure class="page-header" webc:root="override">
  <!-- 1. Render the background image layer only if a path is provided -->
  <picture webc:if="image">
    <img
      :src="image"
      :alt="alt || 'Section header graphic'"
      width="1200"
      height="300"
    />
  </picture>

  <!-- 2. Text layout content block linked to your central grid boundaries -->
  <div class="page-header-info">
    <div class="content">
      <h1 @text="title"></h1>
      <p webc:if="description" @text="description"></p>
    </div>
  </div>

  <!-- 3. Your newly perfected translucent theme toggle stays anchored in the top right -->
  <theme-toggle></theme-toggle>
</figure>

<!-- Move your existing .page-header CSS nested block right in here! -->
<style>
  .page-header {
    height: 220px;
    background-color: var(--camo-8);
    background-image: var(--gradient-30);
    color: #fff;
    display: flex;
    align-items: center;
    position: relative;
    margin-bottom: var(--size-1);

    .theme-toggle {
      position: absolute;
      top: var(--size-3);
      right: var(--size-3);
      z-index: 3;
      margin: 0;
      padding: var(--size-2);
      border-radius: var(--radius-round, 1e5px);
      cursor: pointer;
      background: color-mix(in srgb, var(--sand-12), transparent 90%);
      backdrop-filter: blur(4px);
      border: 1px solid color-mix(in srgb, var(--sand-0), transparent 90%);
      transition:
        background-color 0.2s var(--ease-out-2),
        transform 0.15s var(--ease-out-2);
      --nav-icon: color-mix(in srgb, var(--sand-0), transparent 15%);
      --nav-icon-hover: var(--sand-0);

      &:hover {
        background: color-mix(in srgb, var(--sand-12), transparent 75%);
        transform: scale(1.05);
      }
      &:active {
        transform: scale(0.95);
      }
    }

    > picture {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 100%;
      z-index: 1;

      > img[width][height] {
        height: 100%; /* Or height: inherit; */
        width: 100%;
        object-fit: cover;
        object-position: bottom;
        filter: brightness(0.75);
      }
    }

    .page-header-info {
      grid-column: content;
      z-index: 2;
      display: flex;
      width: 100%;
      max-inline-size: 100%;

      .content {
        flex: 1;
        display: flex;
        max-width: 560px;
        flex-direction: column;
        justify-content: center;
        gap: var(--size-2, 8px); /* Tighten the gap slightly */
        z-index: 2;
        background: var(--page-header-background-color);
        clip-path: polygon(100% 0, 100% 31%, 92% 100%, 0 100%, 0 0);
        /* MODIFICATION: Reduce top/bottom padding slightly to fit the 220px container perfectly */
        padding: var(--size-3, 16px) var(--size-5, 32px) var(--size-3, 16px)
          var(--size-4, 24px);

        width: 95%;

        > h1 {
          font-family: "Merriweather Sans", sans-serif;
          /* Slightly lower the fluid roof sizing from 3rem to 2.5rem for a punchy, compact look */
          font-size: clamp(1.75rem, 4vw, 2.5rem);
          line-height: var(--font-lineheight-1, 1.1);
          font-weight: 800;
          letter-spacing: -0.03em;
          text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }
        > p {
          /* Drop down slightly for tighter alignment harmony */
          font-size: clamp(0.95rem, 1.8vw, 1.1rem);
          max-inline-size: 100%;
          color: var(--text-1, #ffffff);
          font-weight: 500;
          padding-inline-end: var(--size-6, 2rem);
        }
      }
    }
  }
</style>
