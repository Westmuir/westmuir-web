    height: 100%;
  }

  .col-inner {
    display: flex;
    justify-content: center;
    div {
      margin-block: auto;
    }
  }

  /* Target the injected slot container divs directly */
  .col-outer.col-left-pics div,
  .col-inner.col-mid-pics div,
  .col-outer.col-right-pics div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  /* Image limits */
  .col-mid-pics img,
  .col-mid-pics picture img {
    width: 100%;
    max-width: 200px;
    max-height: 200px;
    object-fit: contain;
    margin: 0 auto;
  }

  .grid-body img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    object-fit: contain;
    max-width: 180px;
    margin-block: var(--size-2);
  }

  .col-left-text p,
  .col-right-text p {
    font-size: clamp(0.8rem, 2vw, 1.2rem);
    line-height: 1.7;

    /* 1. Safe layout: Let code formatters add spaces without affecting the browser */
    white-space: normal;

    /* 2. Precision control: Tighten or loosen the space between your stanzas here */
    margin-top: 0;
    margin-bottom: 1.5rem;

    color: var(--_stanza-color);

    /* Reset internal spacing rules */
    br {
      content: "";
      margin: 0;
    }
  }
  .small .col-left-text p,
  .small .col-right-text p {
    font-size: var(--font-fluid-size-0);
  }

  /* Signature Layout styling */
  .grid-straddle-signature {
    grid-column: 4 / 6;
    margin-top: 1rem;
    text-align: left;
    padding-left: 2rem;
  }

  .signature {
    font-style: italic;
    font-weight: bold;
    font-size: var(--font-size-fluid-1);
    margin: 0;
  }

  .poem-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--size-4, 2rem);
    padding-top: var(--size-2, 1rem);
    border-top: 1px solid oklch(from var(--_bg-color) calc(l * 0.8) c h);
    width: 100%;

    .nav-link {
      font-family: sans-serif;
      font-size: var(--font-size-1, 0.95rem);
      text-transform: uppercase;
      font-weight: bold;
      letter-spacing: 0.05em;
      text-decoration: none;
      color: var(--_title-color, #1a365d);
      transition: color 0.2s ease;

      &:hover {
        color: oklch(from var(--_title-color) calc(l * 1.4) c h);
      }
    }
    .nav-disabled {
      visibility: hidden;
    }
  }

  @media (max-width: 1024px) {
    /* Collapse the flex header linearly so it never squishes images */
    .row-header {
      flex-direction: column;
      gap: 1rem;
    }
    .header-title-text,
    .header-left-images,
    .header-right-images {
      max-width: 100% !important;
      width: 100% !important;
      justify-content: center;
      div {
        justify-content: center;
      }
    }
    .row-header .header-title-images picture img {
      max-width: 120px;
    }

    /* Convert the template grid layout into a true 2-column configuration */
    .grid-body,
    .wide .grid-body,
    .wide-text .grid-body,
    .no-middle-images .grid-body {
      grid-template-columns: 1fr 2fr !important;
      gap: 1.5rem 1rem !important;
    }

    /* ── BLOCK 1: Left Images + Left Stanzas ── */
    .col-left-pics {
      grid-column: 1;
      grid-row: 1;

      div {
        flex-direction: column !important;
        gap: var(--size-2) !important;
      }
    }
    .col-left-text {
      grid-column: 2;
      grid-row: 1;
    }

    /* ── BLOCK 2: Right Images + Right Stanzas ── */
    /* Pulls Column 5 over into the left tracking lane underneath Column 1! */
    .col-right-pics {
      grid-column: 2;
      grid-row: 2;

      div {
        flex-direction: column !important;
        gap: var(--size-2) !important;
      }
    }
    .col-right-text {
      grid-column: 1;
      grid-row: 2;
    }

    /* ── BLOCK 3: Middle Images Column Handling ── */
    /* If the page uses mid images, they center cleanly between the blocks */
    .col-mid-pics {
      grid-column: 1 / -1;
      grid-row: 3;
      flex-direction: row !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      gap: 1rem;

      div {
        flex-direction: row !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
      }
    }

    /* If the page has `.no-middle-images` assigned, hide the mid track entirely */
    .no-middle-images .col-mid-pics {
      display: none !important;
    }

    /* ── BLOCK 4: SIGNATURE & FOOTER NAVIGATION ── */
    .grid-straddle-signature {
      grid-column: 1 / -1;
      grid-row: 4;
      padding-left: 0;
      text-align: center;
      margin-top: 1.5rem;
    }

    .poem-navigation {
      flex-direction: row;
      justify-content: space-around;
      gap: 2rem;
    }
  }

  @media (max-width: 1024px) {
    .poem-navigation {
      flex-direction: row;
      justify-content: space-around;
      gap: 2rem;
    }
  }
</style>
