<template webc:type="js" webc:nokeep>
  export default ({ author, title, $data }) => { const list =
  $data.collections.writtenPoems || []; const currentUrl = $data.page.url; const
  currentIdx = list.findIndex(item => item.url === currentUrl); const prev=
  currentIdx > 0 ? list[currentIdx - 1].url : null; const next= currentIdx <
  list.length - 1 ? list[currentIdx + 1].url : null; return `
  <div class="poem-wrapper">
    <div class="poem-card">
      <!-- ROW 1: HEADER BANNER -->
      <header class="row-header">
        <div class="header-left-images">
          <slot name="header-tl"></slot>
        </div>
        <h2 class="poem-title">${title}</h2>
        <div class="header-right-images">
          <slot name="header-tr"></slot>
        </div>
      </header>

      <!-- ROW 2: THE 5-COLUMN CONTENT MESH -->
      <div class="grid-body">
        <aside class="col-outer col-left-pics">
          <slot name="col-1-images"></slot>
        </aside>
        <section class="col-inner col-left-text">
          <slot name="col-2-text"></slot>
        </section>
        <aside class="col-inner col-mid-pics">
          <slot name="col-3-images"></slot>
        </aside>
        <section class="col-inner col-right-text">
          <slot name="col-4-text"></slot>
        </section>
        <aside class="col-outer col-right-pics">
          <slot name="col-5-images"></slot>
        </aside>

        <!-- STRADDLE FOOTER & NAVIGATION LINKS -->
        <footer class="grid-straddle-signature">
          ${author ? `
          <p class="signature">— ${author}</p>
          ` : ''}

          <nav class="poem-navigation" aria-label="Poem pagination navigation">
            ${prev ? `<a href="${prev}" class="nav-link prev-link"
              >← Previous Poem</a
            >` : '<span class="nav-disabled"></span>'} ${next ? `<a
              href="${next}"
              class="nav-link next-link"
              >Next Poem →</a
            >` : '<span class="nav-disabled"></span>'}
          </nav>
        </footer>
      </div>
    </div>
  </div>
  `;}
</template>

<style webc:type="scss">
                 .poem-wrapper {
                   max-width: 1400px;
                   margin: 2rem auto;
                   padding: 0 1rem;
                   box-sizing: border-box;
                   color: #000;

                   // 1. CAPTURE THE CASCADE FALLBACKS
                  // If the page defines --local-bg, use it; otherwise fallback to antiquewhite
                  --bg-color: var(--local-bg, antiquewhite);

                  // Isolate text color overriders
                  --title-color: var(--local-title-color, #000);
                  --stanza-color: var(--local-stanza-color, #000);

                   // 🚀 BULLETPROOF SPECTRUM BORDER
                   // 1. "from var(--bg-color)" establishes the color source track context
                   // 2. "calc(l * 0.65)" multiplies the existing lightness to drop it safely by 35%
                   // 3. "calc(c * 1.2)" boosts the saturation slightly so it doesn't wash out
                   // 4. "h" passes the raw, unchanged original hue angle straight through
                   --border-theme: oklch(from var(--bg-color) calc(l * 0.65) calc(c * 1.2) h);


                   h2 {
                     color: var(--title-color);
                     font-family: "Kalam", var(--font-humanist);
                   }
                 }


     .poem-card {
         background-color: var(--bg-color);
         border: var(--border-size-3, 3px) solid var(--border-theme);
         border-radius: var(--radius-2, 12px);
         overflow: hidden;
         display: flex;
         flex-direction: column;
       }


             /* Row 1: Symmetrical Flex Header Container */
             .row-header {
               display: flex;
               justify-content: space-between;
               align-items: center;
               gap: 1.5rem;
               padding: 1.5rem 1rem 0.5rem 1rem;
               font-family: var(--font-handwritten, sans-serif);
             }

             /* 🔒 PURE TITLE CENTERING INSURANCE */
             .poem-title {
               flex-grow: 1;
               text-align: center;
               margin: 0;

               /* Ensure the title occupies a completely stable, centered column track footprint */
               position: relative;
               z-index: 2;
             }



  /* FIXED BOX TRACKS FOR SIDE CONTENT */
  .header-left-images,
  .header-right-images {
    display: flex;
    align-items: center;
    width: 15%;
    min-width: 120px;
    flex-shrink: 0;
    gap: 0; /* Reset raw gap to let margin auto handle the calculation */
  }

  .header-right-images {
    justify-content: flex-end;
  }

  /* 🚀 DYNAMIC ALIGNMENT INSIDE THE LEFT HEADER TRACK */
  .header-left-images img:nth-child(2),
  .header-left-images picture:nth-child(2) {
    // Automatically pushes the second header graphic exactly to the Column 2 boundary!
    margin-left: auto;
  }


             /* 🚀 STRIP WRAPPER DIV LAYOUT INTERFERENCE */
             .header-left-images div,
             .header-right-images div {
               display: contents; /* Dissolves the wrapper div, making inner images act as direct flex items */
             }

             /* CONSTRAIN INDIVIDUAL GRAPHICS GENERATION */
             .row-header img,
             .row-header picture img {
               height: 150px;
               width: auto;
               max-width: 150px; /* Constrains multiple items safely side-by-side */
               object-fit: contain;
               flex-shrink: 0;
             }


                 /* Row 2: 5-Column Grid */
                 .grid-body {
                   display: grid;
                   grid-template-columns: 15% 1fr minmax(0, 200px) 1fr 15%;
                   gap: 1rem;
                   align-items: start;
                   padding: 1rem;
                   font-family: "Kalam", var(--font-humanist);

                 }

                 .col-outer,
                 .col-inner {
                   height: 100%;
                 }

                 .col-inner {
                   display: flex;
                   justify-content: center;
                   div {
                     margin-block: auto;
                   }
                 }

                 /* Target the injected slot container divs directly */
                 .col-outer.col-left-pics div,
                 .col-inner.col-mid-pics div,
                 .col-outer.col-right-pics div {
                   display: flex;
                   flex-direction: column;
                   justify-content: space-between;
                   height: 100%;
                 }

                 /* Image limits */
                 .col-mid-pics img,
                 .col-mid-pics picture img {
                   width: 100%;
                   max-width: 200px;
                   max-height: 200px;
                   object-fit: contain;
                   margin: 0 auto;
                 }

                 .grid-body img {
                   width: 100%;
                   height: auto;
                   display: block;
                   border-radius: 4px;
                   object-fit: contain;
                   max-width: 180px;
                   margin-block:var(--size-2);
                 }


               .col-left-text p,
               .col-right-text p {
                   // 🚀 CORRECT OPEN PROPS FLUID CLAMP TOKEN
                   font-size: clamp(0.8rem, 2vw, 1.2rem);
                 line-height: 1.7;

                 /* 1. Safe layout: Let code formatters add spaces without affecting the browser */
                 white-space: normal;

                 /* 2. Precision control: Tighten or loosen the space between your stanzas here */
                 margin-top: 0;
