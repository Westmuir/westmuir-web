                 }

                 .signature {
                   font-style: italic;
                   font-weight: bold;
                   // Scales slightly ahead of the body text for clear visual separation
             font-size: var(--font-size-fluid-1);
                   margin: 0;
                 }

                 /* Responsive Fallback: Collapse on smaller devices */
                 @media (max-width: 1024px) {
                   .grid-body {
                     grid-template-columns: 1fr;
                     gap: 2rem;
                   }
                   .grid-straddle-signature {
                     grid-column: 1 / -1;
                     text-align: center;
                     padding-left: 0;
                   }
                   /* Mobile-first flow controls... */
                   .col-left-text { grid-row: 1; }
                   .col-right-text { grid-row: 2; }
                   .col-mid-pics { grid-row: 3; flex-direction: row; flex-wrap: wrap; justify-content: center; }
                   .col-mid-pics img { max-width: 200px; }
                   .col-left-pics { grid-row: 4; flex-direction: row; }
                   .col-left-pics img, .col-right-pics img { max-width: 100px; }
                   .col-right-pics { grid-row: 5; flex-direction: row; }
                 }

           .poem-navigation {
               display: flex;
               justify-content: space-between;
               align-items: center;
               margin-top: var(--size-4, 2rem);
               padding-top: var(--size-2, 1rem);
               border-top: 1px solid oklch(from var(--bg-color) calc(l * 0.8) c h);
               width: 100%;

               .nav-link {
                 font-family: sans-serif;
                 font-size: var(--font-size-1, 0.95rem);
                 text-transform: uppercase;
                 font-weight: bold;
                 letter-spacing: 0.05em;
                 text-decoration: none;
                 color: var(--local-title-color, #1a365d);
                 transition: color 0.2s ease;

                 &:hover {
                   color: oklch(from var(--local-title-color) calc(l * 1.4) c h);
                 }
               }
               .nav-disabled {
         visibility: hidden;
               }
             }

             @media (max-width: 1024px) {
               .poem-navigation {
                 flex-direction: row;
                 justify-content: space-around;
