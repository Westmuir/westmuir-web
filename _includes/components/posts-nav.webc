<script webc:type="js">
  export default function (context) {
    const prevPost = context.getPrev(context.$data.collections);
    const nextPost = context.getNext(context.$data.collections);

    if (!prevPost && !nextPost) return "";

    let html = `<ul class="post-nav-list">`;

    if (prevPost) {
      html += `
        <li>
          ← Previous<br />
          <a href="${prevPost.url}">${prevPost.data.title}</a>
        </li>`;
    }

    if (nextPost) {
      html += `
        <li>
          Next →<br />
          <a href="${nextPost.url}">${nextPost.data.title}</a>
        </li>`;
    }

    html += `</ul>`;
    return html;
  }
</script>

<style webc:scoped>
  .post-nav-list {
    margin-block: var(--size-5);
  }
</style>
