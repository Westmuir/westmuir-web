<ol reversed class="postlist">
  <li webc:for="post of reverse(list)">
    <article :class="`item-list ${post.data.cardType ?? 'na'}`">
      <a :href="post.url" @text="post.data.title ?? post.url"> </a>
      <div>
        <time
          :datetime="htmlDateString(post.date)"
          @text="readableDate(post.date,'LLLL yyyy')"
        ></time>
        <template webc:nokeep @raw="post.content"></template>
      </div>
    </article>
  </li>
</ol>

<style>
  .postlist {
    padding-inline-start: var(--size-2);

    li {
      max-inline-size: initial;
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }
  .item-list {
    margin: 0 0 1rem 0;
    padding: 0.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-color);
  }
</style>
