<ol reversed class="postlist">
  <li webc:for="post of reverse(list)">
    <article :class="`item-list ${post.data.cardType ?? 'na'}`">
      <a :href="post.url" @text="post.data.title ?? post.url"> </a>
      <div>
        <time :datetime="htmlDateString(post.date)" @text="readableDate(post.date,'LLLL yyyy')"></time>
        <div @html="post.content" webc:nokeep></div>
      </div>
    </article>
  </li>
</ol>

<style>
  .postlist {
    padding-inline-start: var(--size-2);

    li {
      max-inline-size: initial;
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }
</style>
