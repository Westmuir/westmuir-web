<!-- _components/section-cards.webc -->
<ul class="section-cards inline-icon-grid">
  <!--
    The browser checks if an individual sub-page has an override (item.customColor).
    If not, it looks for an inherited section theme variable (--section-color).
    If that's missing too, it falls back to the native light-dark stone token!
  -->
  <li
    class="section-card"
    webc:for="item of cards"
    :style="`
        --card-color: ${item.customColor || 'var(--section-color, light-dark(var(--stone-7), var(--stone-3)))'};
        --card-bg: ${item.customBg || 'var(--section-bg, light-dark(var(--stone-2), var(--stone-10)))'};
      `"
  >
    <a :href="item.url">
      <div class="card-header-row">
        <div class="mini-icon-frame">
          <div class="material-symbols-outlined" @raw="item.icon"></div>
        </div>
        <h3 class="card-title-fallback" @text="item.label"></h3>
      </div>
      <p
        webc:if="item.description"
        class="card-desc-fallback"
        @text="item.description"
      ></p>
    </a>
  </li>
</ul>

<style>
  /* Regular, unscoped CSS that inherits perfectly across the layout cascade */
  ul.section-cards.inline-icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--size-3);
    list-style-type: none;
    padding: 0;
    margin-block: var(--size-4);

    .section-card {
      background-color: var(--card-bg);
      border-top: var(--size-2) solid var(--card-color);
      border-radius: var(--radius-2);
      padding: var(--size-3);
      box-shadow: var(--shadow-1);
      min-height: var(--size-9);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      transition:
        transform 0.2s var(--ease-out-2),
        box-shadow 0.2s var(--ease-out-2),
        background-color 0.2s var(--ease-out-2);

      &:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-3);
        background-color: color-mix(
          in oklab,
          var(--card-bg),
          light-dark(black, white) 8%
        );
      }

      &:focus-within {
        outline: var(--border-size-2) solid var(--card-color);
        outline-offset: var(--size-1);
      }
    }

    .card-header-row {
      display: flex;
      align-items: flex-start;
      gap: var(--size-2);
    }

    .mini-icon-frame {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--card-color);
      @supports (color: contrast-color(red)) {
        color: contrast-color(var(--card-bg));
      }
      flex-shrink: 0;
      margin-top: calc(var(--size-1) / 2);

      .material-symbols-outlined {
        font-size: var(--font-size-2);
      }
    }

    h3.card-title-fallback {
      margin: 0;
      font-size: var(--font-size-fluid-1);
      font-weight: var(--font-weight-6);
      line-height: var(--font-lineheight-1);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;

      /* 1. SAFE STANDALONE FALLBACK:
     Uses your rich color token directly so it has a guaranteed identity hue */
      color: var(--card-color, var(--text-1));

      /* 2. MODERN AUTOMATION OVERRIDE:
     If the browser understands contrast-color(), swap to algorithmic calculation */
      @supports (color: contrast-color(red)) {
        color: contrast-color(var(--card-bg));
      }
    }

    p.card-desc-fallback {
      margin: 0;
      margin-top: var(--size-2);
      font-size: var(--font-size-0);
      line-height: var(--font-lineheight-2);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;

      /* 1. SAFE STANDALONE FALLBACK:
     Mixes 25% black (light mode) or white (dark mode) directly into the token
     for a safe chromatic tone */
      color: color-mix(
        in oklab,
        var(--card-color),
        light-dark(black, white) 25%
      );

      /* 2. MODERN AUTOMATION OVERRIDE:
     Takes the browser's dynamic black or white contrast calculation, and blends
     20% of the underlying background card hue into it for a smooth, cohesive look */
      @supports (color: contrast-color(red)) {
        color: color-mix(
          in srgb,
          contrast-color(var(--card-bg)),
          var(--card-bg) 20%
        );
      }
    }
    a {
      text-decoration: none;
      color: inherit;
      height: 100%;
      display: block;
    }
  }
</style>
