<ul
  class="section-cards inline-icon-grid"
  :style="'--theme-color: ' + themeColor + '; --theme-bg: ' + themeBg + ';'"
>
  <li class="section-card" webc:for="item of cards">
    <a :href="item.url">
      <div class="card-header-row">
        <div class="mini-icon-frame">
          <div class="material-symbols-outlined" @raw="item.icon"></div>
        </div>
        <h3 class="card-title-fallback" @text="item.label"></h3>
      </div>
      <p
        webc:if="item.description"
        class="card-desc-fallback"
        @text="item.description"
      ></p>
    </a>
  </li>
</ul>

<style>
  ul.section-cards.inline-icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--size-3);
    list-style-type: none;
    padding: 0;
    margin-block: var(--size-4);

    .section-card {
      /* The browser dynamically switches these tokens natively */
      background-color: var(
        --theme-bg,
        light-dark(var(--stone-1), var(--stone-11))
      );
      border-top: var(--size-2) solid
        var(--theme-color, light-dark(var(--stone-7), var(--stone-3)));

      border-radius: var(--radius-2);
      padding: var(--size-3);
      box-shadow: var(--shadow-1);

      min-height: var(--size-9);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;

      transition:
        transform 0.2s var(--ease-out-2),
        box-shadow 0.2s var(--ease-out-2),
        background-color 0.2s var(--ease-out-2);

      &:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-3);
        background-color: var(--surface-1);
      }

      &:focus-within {
        outline: var(--border-size-2) solid var(--theme-color);
        outline-offset: var(--size-1);
      }
    }

    .card-header-row {
      display: flex;
      align-items: flex-start;
      gap: var(--size-2);
    }

    .mini-icon-frame {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--theme-color);
      flex-shrink: 0;
      margin-top: calc(var(--size-1) / 2);

      .material-symbols-outlined {
        font-size: var(--font-size-2);
      }
    }

    h3.card-title-fallback {
      margin: 0;
      font-size: var(--font-size-fluid-1);
      font-weight: var(--font-weight-6);
      color: var(--text-1);
      line-height: var(--font-lineheight-1);

      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    p.card-desc-fallback {
      margin: 0;
      margin-top: var(--size-2);
      font-size: var(--font-size-0);
      line-height: var(--font-lineheight-2);
      color: var(--text-2);

      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    a {
      text-decoration: none;
      color: inherit;
      height: 100%;
      display: block;
    }
  }
</style>
