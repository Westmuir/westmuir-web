<nav aria-label="Breadcrumb" class="breadcrumbs-nav">
  <ol class="breadcrumbs-list">
    <!-- Pulling arguments directly out of $data for the filter function -->
    <li
      webc:for="crumb of (getBreadcrumbs($data.page.url, $data.collections.all))"
    >
      <a webc:if="!crumb.isCurrent" :href="crumb.url" @text="crumb.label"></a>
      <span
        webc:if="crumb.isCurrent"
        aria-current="page"
        @text="crumb.label"
      ></span>
    </li>
  </ol>
</nav>

<style>
  :where(.breadcrumbs-nav) {
    --link-color: light-dark(var(--cyan-9), var(--cyan-3));
    --hover-color: var(--primary);

    padding-block: var(--size-1);
    margin-bottom: var(--size-1);
    font-size: var(--font-size-0);

    .breadcrumbs-list {
      display: flex;
      flex-wrap: wrap;
      list-style: none;
      padding: 0;
      margin: 0;
      gap: var(--size-2);
      color: var(--text-2);

      li:not(:last-child)::after {
        /* Uses standard text color for the separator symbol */
        content: "/";
        margin-left: var(--size-2);
        color: var(--text-primary);
      }

      a {
        /* Uses your newly fixed light-dark link token */
        color: var(--link-color);
        text-decoration: none;

        &:hover {
          text-decoration: underline;
          color: var(--hover-color);
        }
      }

      span {
        color: var(--text-primary);
        font-weight: var(--font-weight-5);
      }
    }
  }
</style>
