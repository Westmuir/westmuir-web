<nav class="navigation-lane" webc:root="override">
  <button
    class="ui-button top menu-toggle-btn menu-button"
    commandfor="drawer-inline-start-html"
    command="show-modal"
    aria-haspopup="dialog"
    aria-controls="drawer-inline-start-html"
  >
    <svg
      class="hamburger-icon"
      viewBox="0 0 24 24"
      width="24"
      height="24"
      stroke="currentColor"
      stroke-width="2.5"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line class="line-top" x1="3" y1="12" x2="21" y2="12"></line>
      <line class="line-mid" x1="3" y1="6" x2="21" y2="6"></line>
      <line class="line-bot" x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
  <nav-links></nav-links>
</nav>

<dialog
  class="ui-drawer ui-scroll-lock ui-inline-start"
  id="drawer-inline-start-html"
  closedby="any"
>
  <div class="ui-header">
    <span>Inline Start</span>
    <button
      class="ui-icon-button"
      title="Close"
      onclick="this.closest('dialog').close()"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
        />
      </svg>
    </button>
  </div>
  <div class="ui-content">
    <nav class="mobile-only-menu">
      <nav-links></nav-links>
    </nav>
  </div>
  <div class="ui-footer">
    <button
      class="ui-button ui-small"
      commandfor="drawer-inline-start-html"
      command="close"
    >
      Close
    </button>
  </div>
</dialog>

<style>
  :where(.navigation-lane) {
    justify-content: center;
    --_accent: var(--primary);

    --_accent-contrast: var(--gray-1);

    --_hover-color: var(--primary-hover);

    display: flex;
    align-items: center;
    position: relative;
    background-color: var(--primary);
  }

  /* 1. Desktop Defaults */
  .menu-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--size-2);
    color: var(--primary-contrast);
  }

  .nav-links {
    display: flex;
    gap: var(--size-5);
  }

  .nav-links a {
    /* Links now natively pull the unified grey-1 text overlay color specification */
    color: var(--text-primary-contrast);
    text-decoration: none;
    font-weight: var(--font-weight-6);
    padding-block: var(--size-2);
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    /* Smoothly lightens up your bright blue theme color on link hover states */
    color: var(--_hover-color);
  }

  .nav-links a.active {
    color: var(--text-contrast);
    font-weight: var(--font-weight-7);
    text-decoration: underline;
    text-underline-offset: var(--size-1);
  }

  dialog.ui-drawer .nav-links {
    background-color: var(--primary);
    flex-direction: column;
    gap: var(--size-4);
    padding: var(--size-5);
    width: 100%;
  }
  @media (min-width: 768px) {
    /* Hide the drawer toggle button on desktop */
    .menu-toggle-btn {
      display: none;
    }
  }

  @media (max-width: 767px) {
    /* Hide the raw inline header nav on mobile */
    .navigation-lane .nav-links {
      display: none;
    }
  }
</style>
