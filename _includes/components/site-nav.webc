<button id="open-nav-button" aria-label="open sidebar" aria-expanded="false" aria-controls="navbar">
  <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#c9c9c9">
    <path
      d="M165.13-254.62q-10.68 0-17.9-7.26-7.23-7.26-7.23-18t7.23-17.86q7.22-7.13 17.9-7.13h629.74q10.68 0 17.9 7.26 7.23 7.26 7.23 18t-7.23 17.87q-7.22 7.12-17.9 7.12H165.13Zm0-200.25q-10.68 0-17.9-7.27-7.23-7.26-7.23-17.99 0-10.74 7.23-17.87 7.22-7.13 17.9-7.13h629.74q10.68 0 17.9 7.27 7.23 7.26 7.23 17.99 0 10.74-7.23 17.87-7.22 7.13-17.9 7.13H165.13Zm0-200.26q-10.68 0-17.9-7.26-7.23-7.26-7.23-18t7.23-17.87q7.22-7.12 17.9-7.12h629.74q10.68 0 17.9 7.26 7.23 7.26 7.23 18t-7.23 17.86q-7.22 7.13-17.9 7.13H165.13Z"
    />
  </svg>
</button>

<nav aria-label="Site navigation" id="site-nav">
  <ul role="list">
    <li>
      <button id="close-nav-button" aria-label="close sidebar">
        <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#c9c9c9">
          <path
            d="m480-444.62-209.69 209.7q-7.23 7.23-17.5 7.42-10.27.19-17.89-7.42-7.61-7.62-7.61-17.7 0-10.07 7.61-17.69L444.62-480l-209.7-209.69q-7.23-7.23-7.42-17.5-.19-10.27 7.42-17.89 7.62-7.61 17.7-7.61 10.07 0 17.69 7.61L480-515.38l209.69-209.7q7.23-7.23 17.5-7.42 10.27-.19 17.89 7.42 7.61 7.62 7.61 17.7 0 10.07-7.61 17.69L515.38-480l209.7 209.69q7.23 7.23 7.42 17.5.19 10.27-7.42 17.89-7.62 7.61-17.7 7.61-10.07 0-17.69-7.61L480-444.62Z"
          />
        </svg>
      </button>
    </li>
    <li>
      <a href="/" :class="'/' === pageurl?'active-link':''" :aria-current="page.url === '/' ? 'page' : ''">Home</a>
    </li>

    <site-nav-entry
      :@item="item"
      :@pageurl="pageurl"
      webc:for="item of eleventyNavigation($data.collections.all)"
      webc:nokeep
    ></site-nav-entry>
  </ul>
</nav>

<div id="overlay" aria-hidden="true"></div>

<script>
  let openNavButton;

  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('#site-nav');
    const openNavButton = document.getElementById('open-nav-button');

    const closeSidebar = () => {
      navbar.classList.remove('show');
      openNavButton.setAttribute('aria-expanded', 'false');
      navbar.setAttribute('inert', '');
    };

    const updateNavbar = e => {
      // if matches then implies isMobile,  so set to be inert
      e?.matches ? navbar.setAttribute('inert', '') : navbar.removeAttribute('inert');
    };

    window.matchMedia('(width < 700px)').addEventListener('change', e => updateNavbar(e));

    openNavButton?.addEventListener('click', () => {
      navbar.classList.add('show');
      openNavButton.setAttribute('aria-expanded', 'true');
      navbar.removeAttribute('inert');
    });

    document.getElementById('close-nav-button')?.addEventListener('click', () => {
      closeSidebar();
    });

    document.getElementById('overlay')?.addEventListener('click', e => {
      closeSidebar();
    });

    updateNavbar();
  });
</script>

<style>
  :host {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .dropdown__title {
    background-color: transparent;
    border: none;
    font-family: inherit;
  }

  #open-nav-button {
    display: none;
    background: none;
    border: none;
    padding: 1em;
    margin-left: auto;
    cursor: pointer;
  }

  #close-nav-button {
    display: none;
    background: none;
    border: none;
    padding: 1em;
    cursor: pointer;
  }

  #overlay {
    background: rgba(0, 0, 0, 0.5);
    position: fixed;
    inset: 0;
    z-index: 9;
    display: none;
  }

  #site-nav {
    background-color: var(--primary-color);
    display: grid;
    place-items: end;
    user-select: none;
    padding: 0 1rem;

    > ul {
      grid-auto-flow: column;

      > li {
        margin: 0 0.5rem;

        a,
        .dropdown__title {
          text-decoration: none;
          text-align: left;
          display: inline-block;
          color: var(--header-text-color, #fff);
          font-size: 1.1rem;

          &:focus {
            outline: none;
          }
        }

        > a,
        .dropdown__title {
          padding: 1rem 0.5rem;
          border-top: 3px solid transparent;
          transition: 280ms all 120ms ease-out;

          &:hover,
          &:focus {
            border-top-color: var(--teal-3);
            color: var(--teal-3);
          }
        }
      }
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;

      li {
        padding: 0;
      }
    }

    .dropdown {
      position: relative;

      .dropdown__title {
        display: inline-flex;
        align-items: center;

        &:after {
          content: '';
          border: 0.35rem solid transparent;
          border-top-color: rgba(255, 255, 255, 0.45);
          margin-left: 0.25em;
          transform: translateY(0.15em);
        }
      }

      .dropdown__menu {
        position: absolute;
        min-width: 15ch;
        left: 20%;
        top: calc(100% - 0.5rem);
        transition: 280ms all 120ms ease-out;
        transform: rotateX(-90deg) translateX(-20%);
        transform-origin: top center;
        visibility: hidden;
        opacity: 0.3;
        padding: 0.5em 0;
        background-color: light-dark(var(--camo-8), var(--camo-10));
        border-radius: 4px;
        box-shadow: 0 0.15em 0.25em rgba(0, 0, 0, 0.25);

        a {
          color: light-dark(var(--gray-2), var(--camo-1));
          display: block;
          padding: 0.25em;
          opacity: 0;
          transition: 280ms all 120ms ease-out;

          &:hover {
            color: light-dark(#fff, var(--teal-1));
            background-color: light-dark(var(--camo-9), var(--teal-10));
          }
        }
      }

      &:after {
        content: '';
        border: 0.5rem solid transparent;
        border-bottom-color: #f00;
        position: absolute;
        top: calc(100% - 1.25rem);
        left: 50%;
        transform: translateX(-50%);
        transition: 280ms all 120ms ease-out;
        opacity: 0;
        will-change: opacity;
      }

      &:hover,
      &:focus-within {
        .dropdown__title {
          border-top-color: var(--teal-3);
        }

        .dropdown__menu {
          opacity: 1;
          transform: rotateX(0) translateX(-20%);
          visibility: visible;

          a {
            opacity: 1;
          }
        }
      }
    }
  }

  @media (--md-n-below) {
    #open-nav-button,
    #close-nav-button {
      display: block;
    }

    #site-nav {
      position: fixed;
      top: 0;
      right: -100%;
      height: 100vh;
      width: min(15em, 100%);
      z-index: 10;
      display: flex;
      place-items: start;
      border-left: 1px solid var(--hover-color);
      transition: right 300ms ease-in-out;
      padding: 0;

      &.show {
        right: 0;
      }

      &.show ~ #overlay {
        display: block;
      }

      ul {
        width: 100%;
        display: flex;
        flex-direction: column;

        > li:not(.dropdown) {
          &:hover {
            a {
              text-decoration: underline;
            }

            background-color: rgba(102, 51, 153, 0.15);
          }
        }
      }

      li {
        margin-top: 0;
        margin-bottom: 0;
      }

      > ul {
        > li {
          margin: 0;

          a,
          .dropdown__title {
            padding: 0.5rem 0.5rem;
          }

          > a,
          .dropdown__title {
            padding: 1rem 1.5em 1rem 0.5rem;

            border-top: none;
            transition: none;

            &:hover,
            &:focus {
              color: inherit;
            }
          }
        }
      }

      .dropdown {
        > ul {
          width: calc(100% - 1.5em);
          padding-left: 1em;
          margin-left: 0.75em;
          background-color: var(--primary-color-darker, #222);
          border-radius: 10px;
        }

        .dropdown__title {
          &:after {
            content: '';
            background-size: 1.125em 1.125em;
            border: 0.45rem solid #0000;
            border-top-color: #6a89fe;
            margin-left: 0.55em;
            transform: translateY(0.2em);
          }
        }

        .dropdown__menu {
          display: block;
          position: relative;
          visibility: visible;
          opacity: 1;
          transform: none;
          transition: none;
          background-color: var(--primary-color-darker, #222);
          box-shadow: none;
          left: 0;
          top: 0;

          a {
            color: #fff;
            opacity: 1;

            &:hover {
              text-decoration: underline;
            }
          }
        }

        > [role='list'] {
          padding-inline-start: 0.75rem;
        }

        &:after {
          display: none;
        }

        &:hover,
        &:focus-within {
          .dropdown__title {
            border-top-color: inherit;
          }

          .dropdown__menu {
            transform: none;
          }
        }
      }
    }
  }
</style>
