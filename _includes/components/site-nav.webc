<nav class="navigation-lane" webc:root="override">
  <button
    class="ui-button top menu-toggle-btn menu-button"
    commandfor="drawer-inline-start-html"
    command="show-modal"
    aria-haspopup="dialog"
    aria-controls="drawer-inline-start-html"
  >
    <svg
      class="hamburger-icon"
      viewBox="0 0 24 24"
      width="24"
      height="24"
      stroke="currentColor"
      stroke-width="2.5"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line class="line-top" x1="3" y1="12" x2="21" y2="12"></line>
      <line class="line-mid" x1="3" y1="6" x2="21" y2="6"></line>
      <line class="line-bot" x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
  <nav-links></nav-links>
</nav>

<dialog
  class="ui-drawer ui-scroll-lock ui-inline-start"
  id="drawer-inline-start-html"
  closedby="any"
>
  <div class="ui-header">
    <span>Inline Start</span>
    <button
      class="ui-icon-button"
      title="Close"
      onclick="this.closest('dialog').close()"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
        />
      </svg>
    </button>
  </div>
  <div class="ui-content">
    <nav class="mobile-only-menu">
      <nav-links></nav-links>
    </nav>
  </div>
  <div class="ui-footer">
    <button
      class="ui-button ui-small"
      commandfor="drawer-inline-start-html"
      command="close"
    >
      Close
    </button>
  </div>
</dialog>

<style>
  :where(.navigation-lane) {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;

    /* 1. Use your theme's native primary color tokens */
    background-color: var(--primary);
    color: var(--primary-contrast);
    /* Dynamic background: Brand color in light mode, Dark surface color in dark mode */
    background-color: light-dark(var(--primary), var(--surface-filled));

    /* Dynamic text: High-contrast light gray on light mode, Default text on dark mode */
    color: light-dark(var(--primary-contrast), var(--text-primary));
  }

  /* Update the Desktop Defaults to look for the dynamic container color */
  .menu-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--size-2);
    color: inherit; /* Inherits the dynamic text color from .navigation-lane */
  }
  /* FORCE THE FLEX ROW GAP BACK ON STANDARD SCREENS */
  .nav-links {
    display: flex;
    flex-direction: row;
    gap: var(--size-5);
  }

  .nav-links a {
    color: inherit; /* Inherits the dynamic text color */
    text-decoration: none;
    font-weight: var(--font-weight-6);
    padding-block: var(--size-2);
    transition: opacity 0.2s ease;
  }

  .nav-links a.active {
    /* Active underline color switches contextually */
    color: light-dark(var(--primary-contrast), var(--primary));
    font-weight: var(--font-weight-7);
    text-decoration: underline;
    text-underline-offset: var(--size-1);
  }

  .nav-links a:hover {
    /* Instead of tracking a broken hover variable, a clean opacity drop
       safely handles any theme background color */
    opacity: 0.8;
  }
  /* Open Props Drawer Specific Overrides */
  dialog.ui-drawer {
    /* Uses your system surfaces token to respect system Light/Dark settings */
    background-color: var(--surface-default);

    .nav-links {
      display: flex;
      flex-direction: column;
      gap: var(--size-4);
      padding: var(--size-5);
      width: 100%;
      background: none; /* Let the parent dialog fill the background surface */
    }

    .nav-links a {
      /* Flips links back to standard high-contrast text since the
         drawer background is a surface layout layer, not solid --primary */
      color: var(--text-primary);
    }

    .nav-links a.active {
      /* Underline active layout options in the standard primary brand color */
      color: var(--primary);
      text-decoration: underline;
    }
  }

  /* Responsive Display Rules */
  @media (min-width: 768px) {
    /* Hide the drawer hamburger button on desktop viewports */
    .menu-toggle-btn {
      display: none !important;
    }
  }

  @media (max-width: 767px) {
    /* Hide the desktop nav bar links box on narrow mobile viewports */
    .navigation-lane .nav-links {
      display: none !important;
    }
  }
</style>
