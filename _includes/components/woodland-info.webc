<h2 @text="title"></h2>
<div class="species-facts">
  <figure>
    <!-- Trigger Button wrapped around the image for accessible zoom activation -->
    <button
      type="button"
      class="lightbox-trigger"
      aria-haspopup="dialog"
      :aria-label="'Enlarge ' + alt"
    >
      <img
        :src="src"
        :alt="alt"
        width="1920"
        sizes="(min-width: 768px) 35ch, 92vw"
      />
    </button>
    <p @text="alt"></p>
  </figure>
  <div>
    <h4>Species Facts</h4>
    <div class="sf-stack">
      <slot name="species-facts"></slot>
    </div>
  </div>
</div>
<div class="species-information prose light-bg">
  <h2>Species information</h2>
  <div>
    <h4>Identification</h4>

    <slot name="species-info"></slot>

    <hr class="ui-divider" />

    <h4>Distribution</h4>
    <p @text="distribution"></p>
  </div>
</div>

<dialog class="ui-dialog lightbox-modal">
  <form method="dialog">
    <!-- Click overlay background close / upper corner escape button -->
    <button class="close-btn" aria-label="Close lightbox">✕</button>
  </form>
  <div class="modal-body">
    <!-- The empty target loads the high-res file string only upon interaction -->
    <img src="" :alt="alt" class="lightbox-target" />
    <!-- Conditional check and text mapping configured for WebC 0.12 -->
    <p webc:if="alt" class="lightbox-caption" @text="alt"></p>
  </div>
</dialog>

<script>
  class WoodlandInfo extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector(".lightbox-trigger");
      const dialog = this.querySelector(".lightbox-modal");
      const targetImg = this.querySelector(".lightbox-target");

      if (!trigger || !dialog || !targetImg) return;

      // Extract the current rendered image source string
      const sourceImage = trigger.querySelector("img");
      const currentSrc = sourceImage ? sourceImage.getAttribute("src") : "";

      trigger.addEventListener("click", () => {
        // Dynamic Allocation Loop: Keeps page loads instant on weak mobile links
        targetImg.setAttribute("src", currentSrc);

        // Native, fully focus-trapped browser dialogue opening sequence
        dialog.showModal();
      });

      // Accessible Overlay Exit (Clicking the backdrop shadow dismisses the layout modal)
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  }

  // Register the element layout safely within the page pipeline
  if (!customElements.get("woodland-info")) {
    customElements.define("woodland-info", WoodlandInfo);
  }
</script>

<style>
  .species-facts {
    gap: var(--size-7);
    margin-block: var(--size-7);
    display: grid;
    align-items: start;
    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sf-stack {
    display: flex;
    flex-direction: column;
    padding-inline-start: var(--size-1);

    span {
      font-weight: var(--font-weight-7);
      font-size: var(--font-size-3);
    }
  }

  .light-bg {
    --content-light-bg: light-dark(var(--color-3), var(--color-12));

    background-color: var(--content-light-bg);
  }

  .species-information {
    --border-color: var(--surface-3);
    padding-block: var(--size-3);
    padding-inline: var(--size-4);

    hr {
      margin-block: var(--size-fluid-3);
    }
  }

  .lightbox-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: zoom-in;
    width: 100%; /* Spans the full width of Open Props' figure column box model */
    display: block;
  }

  .lightbox-trigger img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-3);
    transition: transform 0.2s var(--ease-3);
  }

  .lightbox-trigger:hover img {
    transform: scale(1.015); /* Snappy tactile micro-interaction */
  } /* --- Lightbox Button Reset --- */

  /* --- Open Props UI Native Dialog Configurations --- */
  .lightbox-modal {
    max-inline-size: min(92vw, var(--size-content-4, 80rem));
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  /* Full screen overlay dims using your project color metrics */
  .lightbox-modal::backdrop {
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(4px); /* Premium editorial blur */
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--size-3);
  }

  .lightbox-target {
    max-block-size: 82svh; /* Locks inside vertical viewport limits on tablets/mobile */
    width: auto;
    height: auto;
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-6);
  }

  .lightbox-caption {
    color: var(
      --gray-2
    ); /* High contrast light text over full-bleed modal mask */
    font-size: var(--font-size-1);
    font-style: italic;
    text-align: center;
  }

  .close-btn {
    position: absolute;
    top: calc(var(--size-5) * -1);
    right: 0;
    background: none;
    border: none;
    color: var(--gray-2);
    font-size: var(--font-size-3);
    cursor: pointer;
  }
</style>
