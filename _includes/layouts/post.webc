---
layout: plain
---

<div class="post-wrapper">
  <h1 @text="title"></h1>

  <ul class="post-metadata">
    <li>
      <time :datetime="page.date | htmlDateString(page.date)" @text="readableDate(page.date)"></time>
    </li>
    <li webc:for="tag of filterTagList(tags)"><a :href="`/tags/${slugify(tag)}`" class="post-tag" @text="tag"></a>,</li>
  </ul>

  <div @raw="content" webc:nokeep></div>
  <posts-nav></posts-nav>
  <div>oomph</div>

