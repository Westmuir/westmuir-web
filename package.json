{
  "name": "westmuir-site",
  "type": "module",
  "version": "202507-3",
  "scripts": {
    "start": "eleventy --serve  --quiet",
    "serve": "serve -l 8080 _site",
    "debug": "eleventy --serve ",
    "preview": "eleventy && serve _site",
    "build": "eleventy",
    "fullclean": "del  './_site' './.cache'",
    "clean": "del  './_site/**/*' ",
    "dev:backend": "wrangler pages dev _site --live-reload",
    "eleventy:watch": "eleventy --watch",
    "wrangler:dev": "wrangler pages dev _site --live-reload",
    "dev": "concurrently --kill-others --prefix \"[{name}]\" --prefix-colors \"cyan,orange\" \"npm:eleventy:watch\" \"npm:wrangler:dev\"",
    "devX": "npm-run-all --parallel eleventy:watch wrangler:dev"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.12.0-beta.8",
    "@11ty/webc": "^0.12.0-beta.5",
    "fast-glob": "^3.3.3",
    "lightningcss": "^1.33.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "material-symbols": "^0.48.3",
    "nanoid": "^6.0.2",
    "open-props": "^1.7.23",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "browserslist": "^4.29.5",
    "concurrently": "^10.0.7",
    "del-cli": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "purgecss": "^9.1.0",
    "rimraf": "^6.1.4",
    "serve": "^14.2.7",
    "stylelint": "^18.0.0",
    "wrangler": "^4.160.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "printWidth": 100
        }
      }
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true,
    "sharp@0.35.2": true
  }
}
