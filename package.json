{
  "name": "westmuir-site",
  "type": "module",
  "version": "202507-3",
  "scripts": {
    "start": "eleventy --serve  --quiet",
    "debug": "eleventy --serve ",
    "build": "eleventy",
    "clean": "del  './_site/**/*' '!./_site/img'",
    "fullclean": "del  './_site'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.12.0-beta.7",
    "browserslist": "^4.28.2",
    "del-cli": "^7.0.0",
    "eleventy-plugin-purgecss": "^0.6.0",
    "htl": "^1.0.0",
    "lightningcss": "^1.32.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "material-symbols": "^0.44.10",
    "open-props": "^1.7.23",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "postcss-jit-props": "^1.0.16",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prismjs": "^1.30.0",
    "rimraf": "^6.1.3",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "printWidth": 100
        }
      }
    ]
  },
  "dependencies": {
    "@11ty/webc": "^0.12.0-beta.2",
    "nanoid": "^5.1.11"
  }
}
