<ul class="section-cards">
  <li class="section-card section-card-page na" webc:for="item of cards">
    <a :href="item.url">
      <div class="section-cards-title">
        <img webc:if="item.image" src="{{ item.image }}" alt="{{ item.label }} image" class="card-image" />
        <div webc:else class="material-symbols-outlined icon" @raw="item.icon"></div>
        <h3 @text="item.label"></h3>
      </div>
      <p @text="item.description"></p>
    </a>
  </li>
</ul>

<style>
  .section-cards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space, 1rem);
    justify-content: flex-start;

    .section-cards-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    a {
      text-decoration: none;
      color: inherit;
    }
  }

  ul.section-cards {
    list-style-type: '';
    margin: 5px 0 0 0;
    padding: 0;

    li {
      display: inline-block;
      margin: 0 0 0.5rem 0;
      padding: 0.5rem;
      border-top: 1px solid var(--border-color, #ddd);
      border-left: 1px solid var(--border-color, #ddd);
      border-right: 1px solid var(--border-color, #ddd);
      border-radius: 0.5rem;
      box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.1);
    }
  }

  .section-cards .hall,
  .postlist .hall {
    border-bottom: 10px solid var(--margin-color-hall, #803f6380);
  }

  .section-cards .na,
  .postlist .n-a {
    border-bottom: 10px solid var(--margin-color-na, #3f4f8080);
  }

  .section-card {
    width: 150px;
    overflow: hidden;
    background-color: var(--background-color, #fff);

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    h3 {
      margin-top: 0;
      font-size: medium;
    }

    p {
      margin-top: 0;
      font-size: smaller;
    }

    .icon {
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
    }
  }
</style>
