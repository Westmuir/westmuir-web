    font-size: 0.875rem;
  }

  .footer a {
    color: var(--footer-link-color);
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer {
      font-size: 0.75rem;
      padding: 0.75rem;
    }
  }

  .footer nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .footer nav a {
    color: var(--footer-link-color);
    text-decoration: none;
    font-weight: 500;
  }

  .footer nav a:hover {
    text-decoration: underline;
