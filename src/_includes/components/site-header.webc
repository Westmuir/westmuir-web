<header class="site-header">
  <site-nav class="site-nav" :@pageurl="pageurl"></site-nav>
  <button id="theme-toggle" class="theme-toggle-btn" title="Toggle Theme">
    <span id="darkmode-icon" class="material-symbols-outlined">&#xe1ae;</span>
  </button>
</header>

<style>
  .site-header {
    background: var(--primary-color);
    position: sticky;
    top: 0;
    flex-wrap: nowrap;
    align-items: center;
    display: flex;
  }

  .site-nav {
    flex: 1;
    z-index: 10;
  }
</style>
