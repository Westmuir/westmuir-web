<li webc:if="item.children.length" class="dropdown">
  <button
    type="button"
    class="dropdown__title"
    aria-expanded="false"
    :aria-controls="`${item.title}-dropdown`"
    @text="item.key"
    :@click="onDropdown"
  ></button>
  <ul class="dropdown__menu" :id="`${item.title}-dropdown`" role="list">
    <li><a :href="item.url" @text="item.title"></a></li>
    <li webc:for="child of item.children">
      <a :href="child.url" @text="child.title"></a>
    </li>
  </ul>
</li>
<li webc:else><a :href="item.url" @text="item.title"></a></li>
