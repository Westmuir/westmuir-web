<button id="open-nav-button" aria-label="open sidebar" aria-expanded="false" aria-controls="navbar">
  <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#c9c9c9">
    <path
      d="M165.13-254.62q-10.68 0-17.9-7.26-7.23-7.26-7.23-18t7.23-17.86q7.22-7.13 17.9-7.13h629.74q10.68 0 17.9 7.26 7.23 7.26 7.23 18t-7.23 17.87q-7.22 7.12-17.9 7.12H165.13Zm0-200.25q-10.68 0-17.9-7.27-7.23-7.26-7.23-17.99 0-10.74 7.23-17.87 7.22-7.13 17.9-7.13h629.74q10.68 0 17.9 7.27 7.23 7.26 7.23 17.99 0 10.74-7.23 17.87-7.22 7.13-17.9 7.13H165.13Zm0-200.26q-10.68 0-17.9-7.26-7.23-7.26-7.23-18t7.23-17.87q7.22-7.12 17.9-7.12h629.74q10.68 0 17.9 7.26 7.23 7.26 7.23 18t-7.23 17.86q-7.22 7.13-17.9 7.13H165.13Z"
    />
  </svg>
</button>

<nav id="navbar" class="navbar" role="navigation">
  <ul>
    <li>
      <button id="close-nav-button" aria-label="close sidebar">
        <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#c9c9c9">
          <path
            d="m480-444.62-209.69 209.7q-7.23 7.23-17.5 7.42-10.27.19-17.89-7.42-7.61-7.62-7.61-17.7 0-10.07 7.61-17.69L444.62-480l-209.7-209.69q-7.23-7.23-7.42-17.5-.19-10.27 7.42-17.89 7.62-7.61 17.7-7.61 10.07 0 17.69 7.61L480-515.38l209.69-209.7q7.23-7.23 17.5-7.42 10.27-.19 17.89 7.42 7.61 7.62 7.61 17.7 0 10.07-7.61 17.69L515.38-480l209.7 209.69q7.23 7.23 7.42 17.5.19 10.27-7.42 17.89-7.62 7.61-17.7 7.61-10.07 0-17.69-7.61L480-444.62Z"
          />
        </svg>
      </button>
    </li>
    <li class="home-li">
      <a href="/" :class="'/' === pageurl?'active-link':''" :aria-current="page.url === '/' ? 'page' : ''">Home</a>
    </li>

    <li webc:for="item of eleventyNavigation($data.collections.all)">
      <a
        :href="item.url"
        :class="item.url === pageurl?'active-link':''"
        :aria-current="url(pageurl) === item.url ? 'page' : ''"
        @text="item.title"
      >
      </a>
    </li>
  </ul>
</nav>

<div id="overlay" aria-hidden="true"></div>

<style>
  :host {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .nav {
    position: relative;
  }

  .navbar {
    background-color: var(--primary-color);
    border-bottom: 1px solid var(--hover-color);
    flex: 1;
  }

  .navbar ul {
    list-style: none;
    display: flex;
  }

  .navbar .home-li {
    margin-right: auto;
  }

  .navbar li {
    display: flex;
  }

  .navbar a {
    display: flex;
    text-decoration: none;
    color: var(--header-text-color);
    padding: 1em 2em;
    transition: background-color 150ms ease;
  }
  .navbar a:hover {
    background-color: var(--hover-color);
  }

  .navbar a.active-link {
    border-bottom: 2px solid var(--header-text-color);
  }

  .navbar a.accent-link {
    background-color: var(--accent-color);
  }

  #open-nav-button {
    display: none;
    background: none;
    border: none;
    padding: 1em;
    margin-left: auto;
    cursor: pointer;
  }

  #close-nav-button {
    display: none;
    background: none;
    border: none;
    padding: 1em;
    cursor: pointer;
  }
  #overlay {
    background: rgba(0, 0, 0, 0.5);
    position: fixed;
    inset: 0;
    z-index: 9;
    display: none;
  }

  .site-header {
    background: var(--primary-color);
  }

  @media (max-width: 700px) {
    #open-nav-button,
    #close-nav-button {
      display: block;
    }
    .navbar {
      position: fixed;
      top: 0;
      right: -100%;
      height: 100vh;
      width: min(15em, 100%);
      z-index: 10;
      border-left: 1px solid var(--hover-color);
      transition: right 300ms ease-in-out;
    }
    .navbar.show {
      right: 0;
    }
    .navbar.show ~ #overlay {
      display: block;
    }
    .navbar ul {
      width: 100%;
      flex-direction: column;
    }
    .navbar a {
      width: 100%;
      padding-left: 2.5em;
    }
    .navbar a.active-link {
      border-bottom: none;
    }
    .navbar .home-li {
      margin-right: unset;
    }

    .nav-toggle {
      display: block;
      margin-left: auto;
    }

    .cta {
      padding: 1rem;
      text-align: center;
    }

    .hero-content {
      padding: 2rem 1rem;
    }

    footer {
      text-align: center;
      padding: 1rem;
    }
  }
</style>
