---
layout: base.liquid
---

<h1>{{ title }}</h1>


<ul class="post-metadata">
  <li>
    <time datetime="{{ page.date | htmlDateString }}">{{
page.date | readableDate
}}</time>
  </li>
  {%- assign filterTags = tags | filterTagList -%}
  {%- for tag in filterTags %}
    {%- capture tagUrl %}/tags/{{ tag | slugify }}/{% endcapture %}
    <li>
      <a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>
      {%- if not loop.last %},
      {% endif %}
    </li>
  {%- endfor %}
</ul>

{{ content }}

{%- if collections.posts %}
  {%- assign previousPost = collections.posts | getPreviousCollectionItem %} {%- assign nextPost = collections.posts | getNextCollectionItem %}
  {%- if nextPost or previousPost %}
    <ul class="links-nextprev">
      {%- if previousPost %}
        <li class="links-nextprev-prev">
          ← Previous<br/>
          <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a>
        </li>
      {% endif %}
      {%- if nextPost %}
        <li class="links-nextprev-next">
          Next →<br/><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a>
        </li>
      {% endif %}
    </ul>
  {%- endif %}
{%- endif %}