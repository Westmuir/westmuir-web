---
layout: base.webc
---

<script webc:setup>
  const previousPost = getPreviousCollectionItem($data.collections.posts);
  const nextPost = getNextCollectionItem($data.collections.posts);
</script>

<h1 @text="title"></h1>

<ul class="post-metadata">
  <li>
    <time :datetime="page.date | htmlDateString(page.date)" @text="readableDate(page.date)"></time>
  </li>
  <li webc:for="tag of filterTagList(tags)"><a :href="`/tags/${slugify(tag)}`" class="post-tag" @text="tag"></a>,</li>
</ul>

<div @raw="content" webc:nokeep></div>

<ul class="links-nextprev" webc:if="previousPost || nextPost " webc:if="$data.collections.posts">
  <li class="links-nextprev-prev" webc:if="previousPost">
    ← Previous<br />
    <a :href="previousPost.url" @text="previousPost.data.title"></a>
  </li>
  <li class="links-nextprev-next" webc:if="nextPost">
    Next →<br /><a :href="nextPost.url" @text="nextPost.data.title"></a>
  </li>
</ul>
