---
layout: plain
---

<script webc:setup>
  function getPrev(pg) {
    const x = getPreviousCollectionItem($data.collections.posts, pg);
    return x;
  }

  function getnext(pg) {
    return getNextCollectionItem($data.collections.posts, pg);
  }
</script>

<div class="post-wrapper">
  <h1 @text="title"></h1>

  <ul class="post-metadata">
    <li>
      <time :datetime="page.date | htmlDateString(page.date)" @text="readableDate(page.date)"></time>
    </li>
    <li webc:for="tag of filterTagList(tags)"><a :href="`/tags/${slugify(tag)}`" class="post-tag" @text="tag"></a>,</li>
  </ul>

  <div @raw="content" webc:nokeep></div>

  <ul class="links-nextprev" webc:if="getPrev(page) || getnext(page)" webc:if="$data.collections.posts">
    <li class="links-nextprev-prev" webc:if="getPrev(page)">
      ← Previous<br />
      <a :href="getPrev(page).url" @text="getPrev(page).data.title"></a>
    </li>
    <li class="links-nextprev-next" webc:if="getnext(page)">
      Next →<br /><a :href="getnext(page).url" @text="getnext(page).data.title"></a>
    </li>
  </ul>
</div>
