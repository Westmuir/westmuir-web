<ul class="section-cards">
  {% for item in cards %}
    <li class="section-card section-card-page">
      <a href="{{ item.url }}">
        {% if item.image %}
          <img
            src="{{ item.image }}"
            alt="{{ item.label }} image"
            class="card-image" />
        {% else %}
          <div class="material-symbols-outlined icon">{{ item.icon }}</div>
        {% endif %}
        <h3>{{ item.label }}</h3>
        <p>{{ item.description }}</p>
      </a>
    </li>
  {% endfor %}
</ul>