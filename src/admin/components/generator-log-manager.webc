<!--- components/generator-log-manager.webc --->
<!-- 1. The Mobile-Friendly Collapsible Control Form -->
<details class="form-accordion">
  <summary class="btn-toggle">🔧 Generator Log Control Panel</summary>

  <form class="generator-form">
    <!-- Sane 12-char ID holder -->
    <input type="hidden" name="id" class="log-id-field" />

    <div class="title-wrapper">
      <h3 class="form-mode-title ui-h4">New Log Entry</h3>
      <div class="form-error-banner" hidden></div>
    </div>

    <!-- Section A: Log Metadata -->
    <fieldset class="ui-fieldset">
      <legend>1. General Info</legend>
      <div class="form-row">
        <div class="form-group">
          <label for="log-date">Log Date</label>
          <input type="date" id="log-date" name="date" required />
        </div>
        <div class="form-group">
          <label for="log-initials">Operator Initials</label>
          <input
            type="text"
            id="log-initials"
            name="initials"
            maxlength="3"
            required
            placeholder="PR"
          />
        </div>
      </div>
    </fieldset>

    <!-- Section B: Parallel Metrics Symmetrical Blocks -->
    <div class="metrics-sections">
      <fieldset class="ui-fieldset metric-card">
        <legend>2. Start Status</legend>
        <div class="form-group">
          <label for="log-time-start">Time Start</label>
          <input type="time" id="log-time-start" name="time_start" required />
        </div>
        <div class="form-group">
          <label for="log-battery-start">Battery (V)</label>
          <input
            type="number"
            step="0.1"
            inputmode="decimal"
            id="log-battery-start"
            name="battery_start"
            placeholder="-"
          />
        </div>
        <div class="form-group">
          <label for="log-fuel-start">Fuel (%)</label>
          <input
            type="number"
            inputmode="numeric"
            min="0"
            max="100"
            id="log-fuel-start"
            name="fuel_start"
            placeholder="-"
          />
        </div>
        <div class="form-group">
          <label for="log-press-start">Oil Pressure (kPa)</label>
          <input
            type="number"
            inputmode="numeric"
            id="log-press-start"
            name="oil_press_start"
            placeholder="-"
          />
        </div>
      </fieldset>

      <fieldset class="ui-fieldset metric-card">
        <legend>3. End Status</legend>
        <div class="form-group">
          <label for="log-time-end">Time End</label>
          <input type="time" id="log-time-end" name="time_end" required />
        </div>
        <div class="form-group">
          <label for="log-battery-end">Battery (V)</label>
          <input
            type="number"
            step="0.1"
            inputmode="decimal"
            id="log-battery-end"
            name="battery_end"
            placeholder="-"
          />
        </div>
        <div class="form-group">
          <label for="log-fuel-end">Fuel (%)</label>
          <input
            type="number"
            inputmode="numeric"
            min="0"
            max="100"
            id="log-fuel-end"
            name="fuel_end"
            placeholder="-"
          />
        </div>
        <div class="form-group">
          <label for="log-press-end">Oil Pressure (kPa)</label>
          <input
            type="number"
            inputmode="numeric"
            id="log-press-end"
            name="oil_press_end"
            placeholder="-"
          />
        </div>
      </fieldset>
    </div>

    <!-- Section C: Fluids & Reason Matrix -->
    <fieldset class="ui-fieldset">
      <legend>4. Diagnostic State</legend>
      <div class="form-row">
        <div class="form-group">
          <label for="log-reason">Reason Flag</label>
          <select id="log-reason" name="reason" required class="ui-select">
            <option value="M">Maintenance (Maint)</option>
            <option value="A">Alert / Automated Test (Alert)</option>
            <option value="R">Resilience Run (Resilience)</option>
            <option value="S">System Backup Service (Service)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="log-oil-level">Oil Level</label>
          <select id="log-oil-level" name="oil_level" class="ui-select">
            <option value="F">Full (F)</option>
            <option value="L">Low (L)</option>
            <option value="100">100%</option>
          </select>
        </div>
        <div class="form-group">
          <label for="log-coolant">Coolant</label>
          <select id="log-coolant" name="coolant" class="ui-select">
            <option value="F">Full (F)</option>
            <option value="L">Low (L)</option>
          </select>
        </div>
      </div>
      <div class="form-group" style="margin-top: var(--size-2)">
        <label for="log-notes">Log Descriptions / Notes</label>
        <textarea
          id="log-notes"
          name="notes"
          rows="2"
          placeholder="e.g. Added 500ml oil, tested exhaust seal..."
        ></textarea>
      </div>
    </fieldset>

    <!-- Section D: Standard Layout Action Switching Bar -->
    <div class="form-actions-container">
      <div class="task-actions">
        <button type="submit" class="ui-button ui-filled ui-primary">
          Save Entry 💾
        </button>
        <button type="button" class="cancel-edit-btn hidden ui-button ui-tonal">
          Cancel Edits
        </button>
      </div>
      <div class="context-actions">
        <button
          type="button"
          class="switch-to-create-btn hidden ui-button ui-filled"
        >
          Create New Entry
        </button>
      </div>
    </div>
  </form>
</details>

<!-- 2. The Native Dialog Confirmation Fragment Wrapper -->
<dialog
  id="delete-confirm-modal"
  class="ui-dialog ui-card ui-elevated"
  role="alertdialog"
  aria-labelledby="dialog-heading"
  aria-modal="true"
>
  <hgroup>
    <h2 id="dialog-heading" class="ui-h4">⚠️ Permanent Deletion</h2>
  </hgroup>
  <div class="ui-content">
    Are you completely sure you want to permanently delete this generator
    record? This action cannot be reversed.
  </div>
  <div class="ui-actions">
    <button class="ui-button close-modal-btn" type="button" value="cancel">
      Cancel
    </button>
    <button
      class="ui-button ui-filled confirm-delete-btn"
      type="button"
      value="confirm"
    >
      Yes, Delete
    </button>
  </div>
</dialog>

<!-- 3. Dynamic Node Insertion Slot -> Embeds your generator-log-viewer child element instantly -->
<slot></slot>

<script src="/js/generator-log-manager.js" type="module" webc:keep></script>
