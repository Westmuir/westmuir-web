    <div class="cc-deadline-box">
      <strong class="cc-box-label">Important Dates:</strong>
      Nominations open <time datetime="2026-08-17">17 August</time> and close
      <time datetime="2026-09-02">2 September 2026</time>.
    </div>
  </main>

  <!-- Interactive/Actionable Contextual Footer -->
  <footer class="cc-footer">
