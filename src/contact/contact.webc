      input[type="checkbox"] {
        width: 1.75cap;
      }

      .form-group:has(input[type="radio"]:checked) {
        background: var(--pale-green);
        border-color: var(--green);
      }

      textarea {
        box-sizing: content-box;
        min-block-size: 3lh;
        resize: block;
      }

      button {
        background: var(--green);
