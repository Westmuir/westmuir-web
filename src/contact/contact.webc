  <form class="kp" novalidate>
    <label class="form-group">
      First Name
      <input type="text" name="first_name" required />
      <span class="error-message">First name is required</span>
    </label>

    <label class="form-group">
      Last Name
      <input type="text" name="last_name" required />
      <span class="error-message">Last name is required</span>
    </label>

    <label class="form-group span-all">
      Email
      <input type="email" name="email" required />
      <span class="error-message"></span>
    </label>

    <label class="form-group span-all">
      Message
      <textarea name="message" required></textarea>
      <span class="error-message">This field is required</span>
    </label>
    <!-- https://issues.chromium.org/issues/4027891-->
    <fieldset class="span-all">
      <legend>Query Type</legend>

      <label class="form-group">
        <input type="radio" name="query" value="general_enquiry" required />
        General Enquiry
      </label>
      <label class="form-group">
        <input type="radio" name="query" value="support" required />
        Support Request
      </label>

      <span class="error-message">Please select what kind of query.</span>
    </fieldset>

    <label class="form-group span-all">
      <input type="checkbox" name="consent" required />
      I consent to being contacted by the team
      <span class="error-message"
        >You must consent to us contacted you to submit this form.</span
      >
    </label>

    <button class="span-all">Submit</button>
  </form>
</div>
<script>
  // Simple validation script
  const form = document.querySelector("form");

