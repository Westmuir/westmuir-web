    /* fieldset.field-set { */
    /*   border: 0; */
    /*   padding: 0; */
    /**/
    /*   display: grid; */
    /*   gap: inherit; */
    /*   grid-template-columns: subgrid; */
    /* } */
    /**/
    /* fieldset:has([required]) legend, */
    /* .form-group:has(:not([type="radio"])[required]) label { */
    /*   display: flex; */
    /*   gap: 1ch; */
    /*   align-items: center; */
    /**/
    /*   &::after { */
    /*     content: "*"; */
    /*     color: var(--green); */
    /*   } */
    /* } */
    /**/
    /* legend { */
    /*   margin-bottom: 0.5em; */
    /* } */
    /**/
    /* input[type="radio"], */
    /* input[type="checkboxX"] { */
    /*   width: 1.75cap; */
    /* } */
    /**/
    /* .form-group:has(input[type="radio"]:checked) { */
    /*   background: var(--pale-green); */
    /*   border-color: var(--green); */
    /*   color: contrast-color(var(--pale-green)); */
    /* } */
    /* buttonX { */
    /*   background: var(--green); */
    /*   color: var(--white); */
    /*   border: 0; */
    /*   border-radius: 6px; */
    /*   padding: 0.75em 1.5em; */
    /**/
    /*   &:hover, */
    /*   &:focus-visible { */
    /*     background: var(--dark-teal); */
    /*   } */
    /* } */

    h1,
    h2,
    p {
      margin-block: 0;
    }

    input,
    button,
    textarea {
      font: inherit;
      background-color: var(--surface-default);
    }
    padding: 2rem;
    /* background-color: var(--white); */
    border-radius: 1rem;
    max-inline-size: 700px;
    margin: 0 auto;

    :where(form.kp) {
      display: grid;
      gap: 1rem;

      @media (width > 500px) {
        grid-template-columns: repeat(2, 1fr);
      }

      .form-group {
        display: grid;
        gap: 0.25rem;
        grid-template-columns: repeat(auto-fit, minmax());
        grid-auto-rows: min-content;
      }

      .form-group:has(:not([type="radio"])[required]),
      fieldset:has([required]) {
        /* 1. Setup layout for labels and legends */
        & label,
        & legend {
          display: flex;
          gap: 1ch;

          /* 2. Permanent asterisk: Default color when valid/untouched */
          &::after {
            content: "*";
            color: var(--text-muted, #71717a); /* Neutral gray */
          }
        }

        /* 3. Asterisk turns red ONLY when the user triggers an invalid state */
        &:has(:user-invalid) {
          /* & label::after, */
          /* & legend::after { */
          /*   color: var(--_critical); /* Critical red  */
          /* } */

          /* 4. Show the error message at the same time */
          .error-message {
            display: block;
          }
        }
      }
      .form-group:has([type="radio"]) {
        display: flex;
        gap: 1ch;
      }
      .form-group:has([type="checkbox"]) {
        display: grid;
        grid-template-columns: auto 1fr; /* Column 1: the input, Column 2: the label text */
        gap: 0.5rem 1ch; /* Row gap of 0.5rem, column gap of 1 character */
        > input {
          grid-column: 1;
          grid-row: 1;
          align-self: center; /* Vertically centers the checkbox with the first line of text */
        }
        .error-message {
          grid-column: 1 / -1; /* Spans the full width of this specific form group */
          grid-row: 2; /* Drops it safely onto the second row */
          min-width: 0; /* Prevents the text from forcing the column wider */
          font-size: 0.875rem; /* Optional: standard smaller size for errors */
        }
      }

      /* .form-group:has([type="radio"]) { */
      /*   position: relative; */
      /**/
      /*   label::after { */
      /*     content: ""; */
      /*     position: absolute; */
      /*     inset: 0; */
      /*   } */
      /* } */

      .error-message {
        display: none;
        color: var(--_critical);
      }

      .span-all {
        grid-column: 1 / -1;
      }

      input,
      textarea,
      .form-group:has(input[type="radio"]) {
        border: 1px solid var(--_border-color);
        border-radius: 8px;
        padding: 0.75em 1.5em;
      }

      input,
      textarea {
        outline-color: green;
      }

      fieldset {
        border: 0;
        padding: 0;

        display: grid;
        gap: inherit;
        grid-template-columns: subgrid;
      }

      legend {
        margin-bottom: 0.5em;
      }

      input[type="radio"],
      input[type="checkbox"] {
        width: 1.75cap;
      }

      .form-group:has(input[type="radio"]:checked) {
        background: var(--_query-color);
        color: contrast-color(var(--_query-color));
        border-color: var(--_border-color);
      }

      textarea {
        box-sizing: content-box;
        min-block-size: 3lh;
        resize: block;
        field-sizing: content;
      }

      button {
        background: var(--primary);
        color: var(--primary-contrast);

        border: 0;
        border-radius: 6px;
        padding: 0.75em 1.5em;

        &:hover,
        &:focus-visible {
          background: var(--_filled-hover-bg-color);
        }
      }

      input:user-invalid,
      textarea:user-invalid {
        border-color: var(--red);
      }
    }
  }
</style>
