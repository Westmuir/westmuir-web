  //
  // Validate entire form on submit
  form.addEventListener("submit", function (e) {
    e.preventDefault();
    const isValid = e.target.checkValidity();

    if (isValid) {
      alert("Form submitted successfully!");
      console.log("Form data:", new FormData(form));
    } else {
      // Focus first invalid field
      form.querySelector(":invalid")?.focus();
    }
  });
</script>

<style>
  :where(.contact) {
    --pale-green: hsl(148, 38%, 91%);
    --green: hsl(169, 82%, 27%);
    --red: hsl(0, 66%, 54%);
    --white: hsl(0, 0%, 100%);
    --light-teal: hsl(186, 15%, 59%);
    --dark-teal: hsl(187, 24%, 22%);
    --_critical: var(--red);
    --_color: light-dark(var(--color-16), var(--color-1));
    --_color-contrast: light-dark(var(--color-1), var(--color-16));
    --_filled-hover-bg-color: oklch(from var(--primary) calc(l - 0.1) c h);
    --_border-color: light-dark(var(--color-7), var(--color-10));
    --_query-color: light-dark(var(--color-4), var(--color-12));
    --ff-base: "Karla", sans-serif;

    color: var(--text-primary);
    /* accent-color: var(--green); */
    font-size: 1rem;
    font-family: var(--ff-base);
    line-height: 1.6;
