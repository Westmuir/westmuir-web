    /*   field-sizing: content; */
    /**/
    /*   /* Open Props token gives an inviting initial depth */
    /*   min-height: var(--size-11); */
    /**/
    /*   /* Removes the redundant drag handle and protects layouts */
    /*   resize: none; */
