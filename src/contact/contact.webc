    h1,
    h2,
    p {
      margin-block: 0;
    }

    input,
    button,
    textarea {
      font: inherit;
    }
    padding: 2rem;
    /* background-color: var(--white); */
    border-radius: 1rem;
    max-inline-size: 700px;
    margin: 0 auto;

    :where(form.kp) {
      display: grid;
      gap: 1rem;

      @media (width > 500px) {
        grid-template-columns: repeat(2, 1fr);
      }

      .form-group {
        display: grid;
        gap: 0.25rem;
      }

      .form-group:has(:not([type="radio"])[required]) label,
      fieldset:has([required]) legend {
        display: flex;
        gap: 1ch;

        &::after {
          content: "*";
          color: var(--green);
        }
      }

      .form-group:has([type="radio"], [type="checkbox"]) {
        display: flex;
        gap: 1ch;
      }

      .span-all {
        grid-column: 1 / -1;
      }

