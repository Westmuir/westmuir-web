---
title: 'Welcome to Westmuir'
layout: 'plain'
cta: true
hero: false
---

<figure class="page-header">
  <img src="images/east-bank.avif" alt="East bank, Westmuir" />
  <div class="page-header-info">
    <div class="content">
      <h1>Westmuir</h1>
      <p>Welcome to Westmuir Village</p>
    </div>
  </div>
</figure>

<div class="container container-spacing" name="main-content">
  <div class="section">
    <h2 class="main-heading">Quick links</h2>
    <nav-cards :@cards="$data.cards"></nav-cards>

    <section class="hero" xwebc:if="false">
      <div class="hero-content">
        <h1>Welcome to Westmuir</h1>
        <p>Discover the charm of our village, from events to local news.</p>
        <a href="/about/" class="btn">Learn More</a>
      </div>
    </section>

    <h2 class="main-heading">Latest</h2>

    <postslist-articles :list="head(categoryFilter($data.collections.posts, 'featured'), -2)"></postslist-articles>
    <postslist-cards :list="slice(categoryFilter($data.collections.posts, 'featured'), -2)"></postslist-cards>
  </div>
</div>

<div class="container" name="logos">
  <div class="section section-logos">
    <p>
      Westmuir is host to a number of successful companies which operate throughout Angus and much further afield. The
      links below offer contact details and may also lead to further information or to the relevant company website
      where appropriate.
    </p>
    <div class="logos">
      <div class="logo-item">
        <a href="https://www.plovermuircottages.co.uk" target="_blank">
          <img src="images/Plovermuir_1.jpg" alt="Plovermuir cottages" width="200" />
        </a>
      </div>
      <div class="logo-item">
        <a href="https://www.garysinclairarchitecture.com/" target="_blank">
          <img src="images/Gary_Sinclair_1.jpg" alt="Gary Sinclair architecture" width="200" />
        </a>
      </div>
      <div class="logo-item">
        <a href="https://angusscaffolding.co.uk/" target="_blank">
          <img src="images/Angus Scaffold.1.png" alt="Angus Scaffolding Ltd" width="200" />
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container container-spacing" name="main-content">
  <div class="section">
    <cta-volunteer buttonlabel="Read more" buttonurl="/about/volunteers/" xwebc:if="cta"></cta-volunteer>
  </div>
</div>
