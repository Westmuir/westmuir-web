<figure class="page-header">
  <img src="images/east-bank.avif" alt="East bank, Westmuir" />
  <div class="page-header-info">
    <div class="content">
      <h1>Westmuir</h1>
      <p>Welcome to Westmuir Village</p>
    </div>
  </div>
</figure>

<div class="container container-spacing" name="main-content">
  <div class="section">
    <!-- <h2 class="main-heading">Quick links</h2> -->
    <nav-cards :@cards="$data.cards"></nav-cards>

    <section class="hero-content breakout" xwebc:if="false">
      <div class="home-cta">
        <h1 class="main-heading">VILLAGE HALL NEWS</h1>
        <div class="home-cta-text">
          What a year it has been for the hall committee! New walls, windows and doors (and soon a new roof) outside and
          inside new curtains, chairs and crockery, much paid for through successfully applied for grants. All that's
          needed now are some new people to join the committee to help take all the good work forward. We meet about
          four times a year and run a few fund-raising events to keep the hall coffers in good shape. Please consider
          joining us, we're friendly, open to new ideas and would be delighted to see you!
          <div class="home-cta-text-footer">
            For more information please contact Ann (
            <a href="mailto: volunteers@westmuir.org.uk">volunteers&#64;westmuir.org.uk </a>) or join us at the AGM on
            16th June, at 7.30pm. Thanks!
          </div>
        </div>
      </div>
      <!-- <div class="hero-content"> -->
      <!--   <h1>Welcome to Westmuir</h1> -->
      <!--   <p>Discover the charm of our village, from events to local news.</p> -->
      <!--   <a href="/about/" class="btn">Learn More</a> -->
      <!-- </div> -->
    </section>

    <h2 class="main-heading">Latest</h2>

    <postslist-articles :list="head(categoryFilter($data.collections.posts, 'featured'), -2)"></postslist-articles>
    <postslist-cards :list="slice(categoryFilter($data.collections.posts, 'featured'), -2)"></postslist-cards>
  </div>
</div>

