---js
const pagination = {
	data: "poems",
	size: 1,
	alias: "poem",
	layout: "base.webc"
};

const eleventyExcludeFromCollections = true;

const permalink = function(data) {
	return `/other/poems/${this.slugify(data.poem.title)}/`;
};

const eleventyComputed = {
	title: data => `Tagged ${data.poem.title}`,
};
---

<!-- Added eleventy:widths to cap processing at 1200px across all formats -->
<img :src="poem.image" alt="" eleventy:widths="1200" webc:if="poem.image" />
