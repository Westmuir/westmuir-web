<poem-grid :title="poemTitle" :author="author" :theme="bgTheme">

  <!-- Header Section -->
  <img src="/poems/2018-may/image-0.png" alt="" slot="header-tl" />
  <img src="/poems/2018-may/image-1.png" alt="" slot="header-tr" />

  <!-- Column 1 Images (15%) -->
  <div slot="col-1-images">
    <img src="/poems/2018-may/image-6.png" alt="" />
