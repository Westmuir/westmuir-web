endOfYear: false
---
<div class="full-width">
<poem-grid :title="poemTitle" :author="author" :theme="bgTheme">

  <!-- Header Section -->
  <img src="/poems/2018-november/image-0.png" alt="" slot="header-tl" />
  <img src="/poems/2018-november/image-1.png" alt="" slot="header-tr" />

  <!-- Column 1 Images (15%) -->
  <div slot="col-1-images">
    <!-- No side images -->
  </div>

  <!-- Column 2 Text -->
  <div slot="col-2-text">
    <p>
      I Greet the Dawn <br />
      I greet the dawn – a streak of light, <br />
      Waking from slumbers of the night; <br />
      To see unfold a new born day,
    </p>

    <p>
      That is mine to use now as I may; <br />
      Will my chosen path be right, <br />
      For it is still veiled from sight; <br />
      Even if some unknown plight,
    </p>
  </div>

  <!-- Column 3 Middle Images -->
  <div slot="col-3-images">
    <!-- No center images -->
  </div>

  <!-- Column 4 Text -->
  <div slot="col-4-text">
    <p>
      Put plans in disarray, <br />
      I greet the Dawn. <br />
      Gallantly life’s trials I’ll fight, <br />
      And do my best to get it right;
    </p>

    <p>
      For tomorrow is another day, <br />
      When everything may go my way; <br />
      Rising refreshed and with Delight, <br />
      I greet the Dawn.
    </p>
  </div>

  <!-- Column 5 Images (15%) -->
  <div slot="col-5-images">
    <!-- No side images -->
  </div>

</poem-grid>
</div>
