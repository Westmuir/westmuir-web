<div class="full-width">
<poem-grid :title="poemTitle" :author="author" :theme="bgTheme">

  <!-- Header Section -->
  <img src="/poems/2018-november/image-0.png" alt="" slot="header-tl" />
  <img src="/poems/2018-november/image-1.png" alt="" slot="header-tr" />

  <!-- Column 1 Images (15%) -->
  <div slot="col-1-images">
    <!-- No side images -->
  </div>

  <!-- Column 2 Text -->
  <div slot="col-2-text">
    <p>
      I Greet the Dawn
      I greet the dawn – a streak of light,
      Waking from slumbers of the night;
      To see unfold a new born day,
    </p>

    <p>
      That is mine to use now as I may;
      Will my chosen path be right,
      For it is still veiled from sight;
      Even if some unknown plight,
    </p>
  </div>

  <!-- Column 3 Middle Images -->
  <div slot="col-3-images">
    <!-- No center images -->
  </div>

  <!-- Column 4 Text -->
  <div slot="col-4-text">
    <p>
      Put plans in disarray,
      I greet the Dawn.
      Gallantly life’s trials I’ll fight,
      And do my best to get it right;
    </p>

    <p>
      For tomorrow is another day,
      When everything may go my way;
      Rising refreshed and with Delight,
      I greet the Dawn.
    </p>
  </div>

  <!-- Column 5 Images (15%) -->
  <div slot="col-5-images">
    <!-- No side images -->
  </div>

</poem-grid>
</div>
