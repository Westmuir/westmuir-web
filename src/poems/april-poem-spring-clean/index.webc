<poem-grid :title="poemTitle" :author="author" :theme="bgTheme">

  <!-- Header Section -->
  <img src="/images/poems/happy-2020.png" alt="" slot="header-tl" />
  <img src="/images/poems/happy-2020.png" alt="" slot="header-tr" />

  <!-- Column 1 Images (15%) -->
  <div slot="col-1-images">
