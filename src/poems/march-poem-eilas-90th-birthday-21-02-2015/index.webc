  <poem-grid
    class="wide-text"
    :title="poemTitle"
    :author="author"
    :theme="bgTheme"
  >
    <!-- Header Section -->
    <div slot="header-tl"></div>
    <div slot="header-tr">
      <img
        src="/poems/march-poem-eilas-90th-birthday-21-02-2015/image-8.avif"
