---js
// <script>
const pagination = {
	data: "collections",
	size: 1,
	alias: "tag",
	filter: ["all", "posts"],
  layout: "base"
	// addAllPagesToCollections: true,
};

const eleventyExcludeFromCollections = true;

const eleventyComputed = {
	title: "Tagged '{{ tag }}'",
	permalink: function(data) {
		return `/tags/${this.slugify(data.tag)}/`;
	}
};

---
<h1>Tagged “{{ tag }}”</h1>

{% assign postslist = collections[tag] %}
{% include "postslist.liquid" %}

<p>See
  <a href="tags.liquid">all tags</a>.</p>