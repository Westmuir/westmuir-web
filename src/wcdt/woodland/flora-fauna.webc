      padding: 0;
      margin-top: 48px;
      grid-template-columns: auto auto auto;

      .grid-item {
        position: relative;
        height: 400px;

        .card-link {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
