            .figure-image {
              width: 100%;
              height: 100%;
              object-fit: cover;
              border-radius: 30px;
              /* transform: skew(-5deg); */
              /* clip-path: polygon(100% 0, 100% 31%, 92% 100%, 0 100%, 0 0); */
              transform-origin: top left;
              transition: 0.3s ease;
            }

            .caption {
              position: absolute;
              bottom: 0;
              left: 0;
              padding: 1rem;
              color: #fff;
              font-size: 1.25rem;
              font-weight: 700;
              transition:
                transform 0.3s ease,
                opacity 0.3s ease;

              opacity: 1;

              .caption-content {
                transform: translateY(0);
                transition: transform 0.3s ease;

                h3 {
                  font-size: 32px;
                  line-height: 40px;
                  letter-spacing: -2px;
                  font-weight: 700;
                  font-family: 'Merriweather Sans', sans-serif;
                }
              }
            }
          }
        }
      }

      .grid-item:hover .card-link figure .caption .caption-content {
        transform: translateY(-20px);
      }
