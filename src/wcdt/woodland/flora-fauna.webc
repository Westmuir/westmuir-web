          color: inherit;
          text-decoration: none;

          .overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, #0000, #000000e6);
            border-radius: 30px;
            transform-origin: top left;
            transition: 0.3s ease;
            /* transform: skew(-5deg); */

            /* clip-path: polygon(100% 0, 100% 31%, 92% 100%, 0 100%, 0 0); */
          }

          figure {
            position: relative;
            width: 100%;
