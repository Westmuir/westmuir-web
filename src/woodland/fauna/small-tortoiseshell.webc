---
title: Butterflies
layout: base
---

<div class="content-grid flow">
  <figure class="page-header full-width-content" op-center>
    <img
      src="/woodland/fauna/small-tortoiseshell.avif"
      alt="Small Tortoiseshell"
    />
    <div class="page-header-info">
      <div class="content">
        <h1>Small Tortoiseshell Butterfly</h1>
        <p>Aglais urticae</p>
      </div>
    </div>
  </figure>

  <section class="breakout content-image-text">
    <div class="content-image">
      <figure>
        <img
          class="bg-yellow-100 sm-p-3 shadow-lg"
          src="/woodland/fauna/small-tortoiseshell.avif"
          alt="Small Tortoiseshell on board walk in woodland"
        />
      </figure>
    </div>
    <div class="content-text species-facts">
      <h4>Species Facts</h4>
      <ul>
        <li><strong>Category: </strong>Butterfly</li>
        <li><strong>Scientific name: </strong>Aglais urticae</li>
        <li><strong>Wingspan: </strong>50&ndash;56mm</li>
        <li><strong>Status: </strong>Common</li>
      </ul>
    </div>
  </section>

  <species-info @distribution="Common">
    <p>
      It is a medium-sized butterfly that is mainly reddish orange, with black
      and yellow markings on the forewings as well as a ring of blue spots
      around the edge of the wings.
    </p>
  </species-info>
</div>
