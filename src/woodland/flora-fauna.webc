<style>
  .ff-grid-cards {
    h2 {
      font-size: var(--font-size-6);
      font-family: var(--woodland-info-font);
    }

    .grid {
      list-style: none;
      display: grid;
      gap: var(--size-5);
      list-style: none;
      padding: 0;

      grid-template-columns: auto auto auto;

      .grid-item {
        position: relative;
        height: 350px;

        .card-link {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          display: block;
          color: inherit;
          text-decoration: none;

          .overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, #0000, #000000e6);
            border-radius: var(--radius-3);
            transform-origin: top left;
            transition: 0.3s ease;
            /* transform: skew(-5deg); */

            /* clip-path: polygon(100% 0, 100% 31%, 92% 100%, 0 100%, 0 0); */
          }

          figure {
            position: relative;
            width: 100%;
            height: 100%;
            overflow: hidden;

            .figure-image {
              width: 100%;
              height: 100%;
              object-fit: cover;
              border-radius: var(--radius-3);
              /* transform: skew(-5deg); */
              /* clip-path: polygon(100% 0, 100% 31%, 92% 100%, 0 100%, 0 0); */
              transform-origin: top left;
              transition: 0.3s ease;
            }

            .caption {
              position: absolute;
              bottom: 0;
              left: 0;
              padding: 1rem;
              color: #fff;
              font-size: var(--font-size-3);
              font-weight: var(--font-weight-7);
              transition:
                transform 0.3s ease,
                opacity 0.3s ease;

              opacity: 1;

              .caption-content {
                transform: translateY(0);
                transition: transform 0.3s ease;

                h3 {
                  font-size: var(--font-size-5);
                  line-height: var(--font-lineheight-1);
                  letter-spacing: -2px;
                  font-weight: var(--font-weight-7);
                  font-family: var(--woodland-info-font);
                }
              }
            }
          }
        }
      }

      .grid-item:hover .card-link figure .caption .caption-content {
        transform: translateY(-20px);
      }
    }
  }

  @media (--md-n-below) {
    .ff-grid-cards {
      .grid {
        grid-template-columns: auto auto;
      }
    }
  }
</style>
