<woodland-info
  @title="Small Tortoiseshell Butterfly"
  @distribution="Common"
  src="/woodland/birds-foot-trefoil.avif"
  alt="Bird's Foot Trefoil"
>
  <div slot="species-facts">
    <p><span>Category: </span>Wildflower</p>
    <p><span>Scientific name: </span>Lotus corniculatus</p>
    <p><span>Height: </span>up to 35cm</p>
    <p><span>Status: </span>Widespread</p>
  </div>
  <div slot="species-info">
    <p>
      Its yellow flowers look like little slippers and appear in small clusters.
      They are followed by seed pods that look distinctly like bird's feet or
      claws, hence the common name. A low-growing plant, its leaves have five
      leaflets and are downy.
    </p>
  </div>
</woodland-info>
