  <figure class="page-header full-width-content" op-center>
    <img src="/woodland/ling.avif" alt="ling" />
    <div class="page-header-info">
      <div class="content">
        <h1>Ling</h1>
        <p>Calluna vulgaris</p>
      </div>
    </div>
  </figure>

  <section class="breakout content-image-text">
    <div class="content-image">
      <figure>
        <img
          class="bg-yellow-100 sm-p-3 shadow-lg"
          src="/woodland/ling.avif"
          alt=""
        />
      </figure>
    </div>
    <div class="content-text species-facts">
      <h4>Species Facts</h4>
      <ul>
        <li><strong>Category: </strong>Wildflower</li>
        <li><strong>Scientific name: </strong>Calluna vulgaris</li>
        <li><strong>Height: </strong>up to 90cm</li>
        <li><strong>Status: </strong>Common</li>
      </ul>
    </div>
  </section>
  <species-info @distribution="Common in Scotland">
    <p>
      The stems of heather are woody and coarse, sometimes clumped together and
      close to the ground in exposed areas. The delicate pink flowers grow
      loosely up the stem and the short, narrow leaves are borne in rows.
    </p>
  </species-info>
