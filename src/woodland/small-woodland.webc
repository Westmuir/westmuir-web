---
title: Westmuir Woodland
description: Scotland's small woodland winner 2024.
headerImage: "/wcdt/wcdt-banner.avif"
headerAlt: "Small woodland winner"
inContextNav: true
---

<main class="woodland-container breakout">
  <div class="content-grid">
    <!-- Left Column: The Logo Canvas -->
    <div class="grid-column logo-frame">
      <img
        src="/wcdt/woodland-logo.png"
        alt="Westmuir Community Woodland Angus Logo"
        sizes="(min-width: 48em) 50vw, 100vw"
        loading="eager"
      />
    </div>

    <!-- Right Column: Text & Recognition Info -->
    <div class="grid-column info-canvas">
      <header class="recognition-text">
        <h1 class="ui-h2">Westmuir Woodland Recognition</h1>
        <div class="extra-info">
          <p class="award-lead">
            Scotland's Finest Wood Award 2024 in the Small community woodland
            category.
          </p>
          <p class="award-link">
            <a href="https://sfwa.co.uk" target="_blank" rel="noopener"
              >https://sfwa.co.uk</a
            >
          </p>
        </div>
      </header>

      <section class="winner-container">
        <h2 class="winner-title">
          Community Woodland Group - Small Group Winner
        </h2>
        <div class="photo-frame">
          <img
            src="/woodland/PW_SFWA-24_CWA-Small-Winner_Westmuir_Ann-W-with-CabSec-600x402.png"
            alt="Ann W receiving Scotland's Finest Woods Award at the Scottish Parliament"
            sizes="(min-width: 48em) 50vw, 100vw"
            loading="lazy"
          />
        </div>
        <ul class="clean-list micro-metadata">
          <li><strong>Rights:</strong> Free to use images</li>
          <li><strong>Event:</strong> Scotland's Finest Woods Awards 2024</li>
          <li><strong>Venue:</strong> Scottish Parliament</li>
          <li><strong>Date:</strong> 27th November 2024</li>
          <li><strong>Credit:</strong> Picture by Phil Wilkinson</li>
        </ul>
      </section>
    </div>
  </div>
</main>

<style>
  .woodland-container {
    font-family: var(--font-stack);
    color: var(--text-primary);
    max-width: var(--size-content-4, 1140px);
    margin-inline: auto;
    padding: var(--size-5) var(--size-3);
  }

  /* Core Layout Grid System */
  .content-grid {
    display: flex;
    flex-direction: column;
    gap: var(--size-7);
  }

  .grid-column {
    display: flex;
    flex-direction: column;
    gap: var(--size-6);
  }

  /* --- LEFT COLUMN LOGO CANVAS MAGIC --- */
  .logo-frame {
    display: grid;
    place-items: center; /* Centers horizontally and vertically */
    width: 100%;
    height: 100%;
    min-height: 300px; /* Prevents collapsing on smaller mobile portrait views */
  }

  .logo-frame img {
    width: 100%;
    height: auto;
    max-width: 550px; /* Limits size on ultra-wide screens to prevent pixelation */
    object-fit: contain;
    display: block;
  }

  /* --- RIGHT COLUMN CONTENT FORMATTING --- */
  .recognition-text h1 {
    font-size: var(--font-size-5);
    font-weight: var(--font-weight-7);
    color: var(--text-primary);
    margin-bottom: var(--size-3);
    line-height: var(--font-lineheight-1);
  }

  .award-lead {
    font-size: var(--font-size-3);
    line-height: var(--font-lineheight-3);
    color: var(--text-muted);
    margin-bottom: var(--size-2);
  }

  .award-link a {
    color: var(--brand, #107c65);
    text-decoration: underline;
    font-weight: var(--font-weight-5);
  }

  /* Winner Feature Block */
  .winner-container {
    border-top: 1px solid var(--surface-3, #ccc);
    padding-top: var(--size-5);
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .winner-title {
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-6);
    color: var(--text-primary);
    margin: 0;
  }

  .photo-frame img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-2, 6px);
    box-shadow: var(--shadow-2);
    display: block;
  }

  /* Micro Metadata List Tracking */
  .micro-metadata {
    margin: 0;
    padding-inline-start: var(--size-4);
    display: flex;
    flex-direction: column;
    gap: var(--size-1);
  }

  .micro-metadata li {
    font-size: var(--font-size-1);
    color: var(--text-muted);
    line-height: var(--font-lineheight-2);
  }

  /* Desktop View Grid Upgrades */
  @media (min-width: 48em) {
    /* 768px */
    .content-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr; /* Gives the logo side slightly more balance track weight */
      gap: var(--size-8);
      align-items: center; /* Locks the logo and text tracking center lines together */
    }

    .logo-frame {
      min-height: auto; /* Lets the height map dynamically based on text column content height */
    }
  }
</style>
