{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "westmuir-web",
  "pages_build_output_dir": "_site",
  "compatibility_date": "2026-06-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "village_hall_db",
      "database_id": "81cbb631-f5bc-4f09-a4fb-67ddc26c58ae"
    }
  ],
  "assets": {
    "directory": "./_site",
    "run_worker_first": [
      "/api"
    ]
  }
}
